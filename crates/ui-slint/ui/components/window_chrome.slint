import { Theme } from "../theme.slint";
import { AsrGlassLogo } from "asr_logo.slint";

export component VectorIconClose inherits Rectangle {
    in property <length> size: 12px;
    in property <color> icon-color: Theme.text-secondary;
    width: root.size;
    height: root.size;
    background: transparent;

    Path {
        width: 100%;
        height: 100%;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 12;
        viewbox-height: 12;
        stroke: root.icon-color;
        stroke-width: 1.5px;
        fill: transparent;
        commands: "M 2.2 2.2 L 9.8 9.8 M 9.8 2.2 L 2.2 9.8";
    }
}

export component VectorIconChevron inherits Rectangle {
    in property <length> size: 12px;
    in property <bool> up: false;
    in property <bool> right: false;
    in property <color> icon-color: Theme.text-secondary;
    width: root.size;
    height: root.size;
    background: transparent;

    Path {
        width: 100%;
        height: 100%;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 12;
        viewbox-height: 12;
        stroke: root.icon-color;
        stroke-width: 1.5px;
        fill: transparent;
        commands: root.right
            ? "M 4 2.5 L 8 6 L 4 9.5"
            : (root.up ? "M 2.5 8 L 6 4 L 9.5 8" : "M 2.5 4 L 6 8 L 9.5 4");
    }
}

