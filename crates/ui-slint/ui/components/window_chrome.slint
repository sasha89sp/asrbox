    in property <bool> dark-mode: true;
    in property <color> icon-color: Theme.text-primary;
    width: root.size;
    height: root.size;
    background: transparent;

    Path {
        width: 100%;
        height: 100%;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 16;
        viewbox-height: 16;
        stroke: root.icon-color;
        stroke-width: 1.4px;
        fill: transparent;
        commands: root.dark-mode
            ? "M 8 5.2 A 2.8 2.8 0 1 0 8 10.8 A 2.8 2.8 0 1 0 8 5.2 M 8 1.5 L 8 3.2 M 8 12.8 L 8 14.5 M 1.5 8 L 3.2 8 M 12.8 8 L 14.5 8 M 3.4 3.4 L 4.6 4.6 M 11.4 11.4 L 12.6 12.6 M 12.6 3.4 L 11.4 4.6 M 4.6 11.4 L 3.4 12.6"
            : "M 10.8 2.4 A 5.6 5.6 0 1 0 13.6 10.5 A 4.4 4.4 0 0 1 10.8 2.4 Z";
    }
}

