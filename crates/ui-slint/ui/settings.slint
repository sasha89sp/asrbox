import { ScrollView } from "std-widgets.slint";
import {
    Theme,
    SlintModuleRow,
    SlintDockItemRow,
    SlintCalendarSourceRow,
    SlintWebDavServerRow,
    SlintSyncItemRow,
} from "theme.slint";
import { AsrGlassLogo } from "components/asr_logo.slint";
import {
    FramelessTitleBar,
    VectorIconNav,
    WindowResizeHandles,
} from "components/window_chrome.slint";
import { GlassInput } from "components/controls.slint";
import { SettingsGeneralView } from "settings_general.slint";
import { SettingsDockView } from "settings_dock.slint";
import { SettingsWidgetsView } from "settings_widgets.slint";
import { SettingsOverlayView } from "settings_overlay.slint";
import { SettingsDiagnosticsView, SettingsChangelogView } from "settings_tools.slint";

component NavItem inherits Rectangle {
    in property <int> icon-kind: 0;
    in property <string> label;
    in property <bool> active: false;
    callback clicked();

    height: 38px;
    border-radius: 9px;
    background: root.active
        ? @linear-gradient(90deg, Theme.accent 0%, Theme.accent-hover 100%)
        : (ta.has-hover ? Theme.hover-bg : transparent);
    border-width: root.active ? 1px : 0px;
    border-color: root.active ? rgba(255, 255, 255, 0.28) : transparent;
    drop-shadow-blur: root.active ? 14px : 0px;
    drop-shadow-color: root.active ? Theme.accent-glow : transparent;

    animate background { duration: 150ms; easing: ease-out; }

    // Left 3x16px crisp white active pill
    if (root.active) : Rectangle {
        x: 4px;
        y: (parent.height - 16px) / 2;
        width: 3px;
        height: 16px;
        border-radius: 1.5px;
        background: #FFFFFF;
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 12px;
        spacing: 10px;
        alignment: start;

        VerticalLayout {
            alignment: center;
            VectorIconNav {
                kind: root.icon-kind;
                size: 14px;
                icon-color: root.active ? #FFFFFF : Theme.text-secondary;
            }
        }

        Text {
            text: root.label;
            color: root.active ? #FFFFFF : Theme.text-secondary;
            font-size: 13px;
            font-weight: root.active ? 600 : 500;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component SettingsWindow inherits Window {
    title: "Настройки — asrbox";
    preferred-width: 860px;
    preferred-height: 560px;
    min-width: 720px;
    min-height: 480px;
    no-frame: true;
    background: transparent;
    default-font-family: "Segoe UI";

    in property <string> app-version: "0.1.0";
    in-out property <int> active-tab: 0; // 0=General, 1=Dock, 2=Widgets, 3=Overlay
    in-out property <string> search-query: "";
    in property <string> status-banner: "";

    // Accordion expanded & search highlight flags
    in property <bool> show-appearance: true;
    in property <bool> show-system: true;
    in property <bool> show-backup: true;
    in property <bool> show-sync: true;
    in property <bool> show-tools: true;
    in property <bool> hi-appearance: false;
    in property <bool> hi-system: false;
    in property <bool> hi-backup: false;
    in property <bool> hi-sync: false;
    in property <bool> hi-tools: false;
    in property <bool> exp-appearance: true;
    in property <bool> exp-system: true;
    in property <bool> exp-backup: false;
    in property <bool> exp-sync: false;
    in property <bool> exp-tools: false;

    in property <bool> exp-dock-appearance: true;
    in property <bool> exp-dock-behavior: false;
    in property <bool> exp-dock-items: true;
    in property <bool> exp-dock-menu: false;
    in property <bool> hi-dock-appearance: false;
    in property <bool> hi-dock-behavior: false;
    in property <bool> hi-dock-items: false;
    in property <bool> hi-dock-menu: false;

    in property <bool> exp-cal: true;
    in property <bool> exp-sys: true;
    in property <bool> exp-weather: true;
    in property <bool> exp-notes: true;
    in property <bool> exp-overlay-mode: true;
    in property <bool> exp-overlay-layout: true;
    in property <bool> hi-overlay-mode: false;
    in property <bool> hi-overlay-layout: false;

    // General state
    in property <int> design-theme-index: 0;
    in property <int> language-index: 0;
    in property <int> font-renderer-index: 0;
    in property <bool> autostart-enabled: false;
    in property <int> isolation-index: 0;
    in property <[SlintModuleRow]> modules: [];
    in property <string> backup-summary: "";
    in property <string> cloud-status: "";
    in property <bool> backup-auto-upload: false;
    in property <bool> backup-encrypt-zip: false;
    in property <bool> backup-has-zip-pw: false;
    in property <bool> backup-busy: false;
    in property <[SlintWebDavServerRow]> webdav-servers: [];
    in-out property <string> gh-repo: "";
    in-out property <string> gh-branch: "main";
    in property <bool> gh-include-in-backup: false;
    in property <bool> gh-has-token: false;
    in property <string> gh-status: "";
    in property <int> sync-interval-index: 2;
    in property <string> sync-status: "";
    in property <[SlintSyncItemRow]> sync-items: [];
    in property <string> diag-summary: "";
    in property <bool> diag-monitor-enabled: true;
    in property <bool> diag-verbose: false;
    in property <bool> diag-file-log: false;
    in property <string> diag-filter-label: "Все";
    in property <[string]> diag-logs: [];
    in property <string> data-dir-text: "";
    in property <string> exe-path-text: "";
    in property <[string]> changelog-lines: [];

    // Dock state
    in property <[string]> dock-names: ["Док 1"];
    in property <int> selected-dock-index: 0;
    in property <string> selected-dock-name: "Док 1";
    in property <bool> can-remove-dock: false;
    in property <int> dock-edge-index: 0;
    in property <int> dock-layer-index: 0;
    in property <int> dock-label-mode-index: 0;
    in property <int> dock-icon-size-px: 48;
    in property <int> dock-icon-frame-px: 6;
    in property <int> dock-opacity-percent: 88;
    in property <int> dock-edge-margin-px: 12;
    in property <int> dock-corner-radius-px: 16;
    in property <bool> dock-blur-enabled: true;
    in property <bool> dock-locked: true;
    in property <bool> dock-lock-items: false;
    in property <bool> dock-show-running: true;
    in property <bool> dock-focus-running: true;
    in property <bool> dock-launch-anim: true;
    in property <[SlintDockItemRow]> dock-items: [];
    in-out property <int> dock-selected-item-id: -1;
    in-out property <string> dock-rename-input: "";
    in property <bool> dock-menu-open-folder: true;
    in property <bool> dock-menu-launch: true;
    in property <bool> dock-menu-remove: true;
    in property <bool> dock-menu-add-dock: true;

    // Widgets state
    in-out property <int> selected-widget: 0;
    in property <bool> cal-visible: true;
    in property <int> cal-layer: 0;
    in property <int> cal-period: 2;
    in property <int> cal-sync-idx: 2;
    in property <int> cal-opacity: 88;
    in property <int> cal-width: 336;
    in property <int> cal-rows: 8;
    in property <bool> cal-commented-hint: false;
    in property <[SlintCalendarSourceRow]> cal-sources: [];

    in property <bool> sys-visible: true;
    in property <int> sys-layer: 0;
    in property <int> sys-refresh-idx: 1;
    in property <int> sys-opacity: 88;
    in property <int> sys-width: 348;
    in property <int> sys-height: 410;

    in property <bool> weather-visible: true;
    in-out property <string> weather-city: "Москва";
    in property <int> weather-provider-idx: 0;
    in property <int> weather-days-idx: 1;
    in property <bool> weather-has-yandex-key: false;
    in property <int> weather-layer: 0;
    in property <int> weather-opacity: 90;
    in property <int> weather-refresh-min: 30;
    in property <int> weather-width: 360;
    in property <int> weather-height: 410;

    in property <bool> notes-visible: false;
    in property <int> notes-layer: 1;
    in property <int> notes-opacity: 94;
    in property <bool> notes-pane-folders: true;
    in property <bool> notes-pane-list: true;
    in property <bool> notes-pane-editor: true;

    // Overlay state
    in property <bool> ov-module-enabled: true;
    in property <bool> ov-auto-games-only: true;
    in property <bool> ov-force-topmost: true;
    in property <bool> ov-setup-mode: false;
    in property <int> ov-anchor-index: 0;
    in property <int> ov-opacity: 82;
    in property <int> ov-width: 340;
    in property <int> ov-height: 196;
    in property <int> ov-refresh-ms: 500;

    // Window chrome & universal dispatch callbacks
    callback drag-window();
    callback resize-window(int);
    callback minimize-window();
    callback maximize-window();
    callback close-window();
    callback search-changed(string);
    callback dispatch(string, string);
    callback save-webdav-server(int, string, string, string, string);
    callback save-gh-settings(string, string, string);

    public function reset-scroll() {
        scroll.viewport-y = 0px;
    }

    // Outer Concentric Fluent Glass frame (8px matches Windows 11 DWMWCP_ROUND)
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 8px;
        background: Theme.window-bg;
        border-width: 1px;
        border-color: Theme.border-color;
        clip: true;

        VerticalLayout {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 100%;
            spacing: 0px;

            FramelessTitleBar {
                title: (Theme.is-ru ? "Настройки — asrbox v" : "Settings — asrbox v") + root.app-version;
                drag-window => { root.drag-window(); }
                minimize-clicked => { root.minimize-window(); }
                maximize-clicked => { root.maximize-window(); }
                close-clicked => { root.close-window(); }
            }

            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 0px;

                // Left Sidebar (210px, Theme.sidebar-bg)
                Rectangle {
                    width: 210px;
                    background: Theme.sidebar-bg;

                    VerticalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        padding-top: 22px;
                        padding-bottom: 14px;
                        spacing: 6px;

                        // Brand block with radial accent glow
                        VerticalLayout {
                            alignment: center;
                            spacing: 6px;

                            HorizontalLayout {
                                alignment: center;
                                AsrGlassLogo { size: 54px; show-glow: true; }
                            }

                            Text {
                                text: "asrbox";
                                color: Theme.text-primary;
                                font-size: 16px;
                                font-weight: 600;
                                horizontal-alignment: center;
                            }

                            Text {
                                text: "v" + root.app-version;
                                color: Theme.text-muted;
                                font-size: 11.5px;
                                horizontal-alignment: center;
                            }
                        }

                        Rectangle { height: 14px; background: transparent; }

                        NavItem {
                            icon-kind: 0;
                            label: Theme.is-ru ? "Общие настройки" : "General";
                            active: root.active-tab == 0;
                            clicked => {
                                root.active-tab = 0;
                                scroll.viewport-y = 0px;
                            }
                        }
                        NavItem {
                            icon-kind: 1;
                            label: Theme.is-ru ? "Док-панели" : "Dock Panels";
                            active: root.active-tab == 1;
                            clicked => {
                                root.active-tab = 1;
                                scroll.viewport-y = 0px;
                            }
                        }
                        NavItem {
                            icon-kind: 2;
                            label: Theme.is-ru ? "Виджеты" : "Widgets";
                            active: root.active-tab == 2;
                            clicked => {
                                root.active-tab = 2;
                                scroll.viewport-y = 0px;
                            }
                        }
                        NavItem {
                            icon-kind: 3;
                            label: Theme.is-ru ? "Игровой оверлей" : "Game Overlay";
                            active: root.active-tab == 3;
                            clicked => {
                                root.active-tab = 3;
                                scroll.viewport-y = 0px;
                            }
                        }

                        Rectangle {
                            height: 1px;
                            background: Theme.divider-color;
                        }

                        NavItem {
                            icon-kind: 6;
                            label: Theme.is-ru ? "Диагностика и логи" : "Diagnostics";
                            active: root.active-tab == 4;
                            clicked => {
                                root.active-tab = 4;
                                scroll.viewport-y = 0px;
                                root.dispatch("refresh_diag", "");
                            }
                        }
                        NavItem {
                            icon-kind: 7;
                            label: Theme.is-ru ? "История версий" : "Changelog";
                            active: root.active-tab == 5;
                            clicked => {
                                root.active-tab = 5;
                                scroll.viewport-y = 0px;
                            }
                        }

                        Rectangle { vertical-stretch: 1; background: transparent; }

                        if (root.status-banner != "") : Rectangle {
                            border-radius: 6px;
                            background: Theme.card-bg;
                            border-width: 1px;
                            border-color: Theme.border-color;

                            HorizontalLayout {
                                padding: 8px;
                                Text {
                                    text: root.status-banner;
                                    color: Theme.text-secondary;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }

                    // 1px vertical separator
                    Rectangle {
                        x: parent.width - 1px;
                        width: 1px;
                        height: 100%;
                        background: Theme.divider-color;
                    }
                }

                // Right Workspace
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 0px;

                    // Header row: 20px SemiBold title + 220x30px Search input
                    HorizontalLayout {
                        padding-left: 22px;
                        padding-right: 22px;
                        padding-top: 16px;
                        padding-bottom: 12px;
                        spacing: 12px;
                        alignment: stretch;

                        Text {
                            horizontal-stretch: 1;
                            text:
                                root.active-tab == 1 ? (Theme.is-ru ? "Док-панели" : "Dock Panels") :
                                root.active-tab == 2 ? (Theme.is-ru ? "Виджеты" : "Widgets") :
                                root.active-tab == 3 ? (Theme.is-ru ? "Игровой оверлей" : "Game Overlay") :
                                root.active-tab == 4 ? (Theme.is-ru ? "Диагностика и логи" : "Diagnostics & Logs") :
                                root.active-tab == 5 ? (Theme.is-ru ? "История версий" : "Version History") :
                                (Theme.is-ru ? "Общие настройки" : "General Settings");
                            color: Theme.text-primary;
                            font-size: 20px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }

                        GlassInput {
                            width: 220px;
                            text <=> root.search-query;
                            placeholder: Theme.is-ru ? "Поиск" : "Search";
                            trailing-icon: "🔍";
                            edited(q) => { root.search-changed(q); }
                        }
                    }

                    scroll := ScrollView {
                        vertical-stretch: 1;

                        VerticalLayout {
                            padding-left: 22px;
                            padding-right: 22px;
                            padding-top: 4px;
                            padding-bottom: 22px;
                            spacing: 12px;

                            if (root.active-tab == 0) : SettingsGeneralView {
                                show-appearance: root.show-appearance;
                                show-system: root.show-system;
                                show-backup: root.show-backup;
                                show-sync: root.show-sync;
                                show-tools: root.show-tools;
                                hi-appearance: root.hi-appearance;
                                hi-system: root.hi-system;
                                hi-backup: root.hi-backup;
                                hi-sync: root.hi-sync;
                                hi-tools: root.hi-tools;
                                exp-appearance: root.exp-appearance;
                                exp-system: root.exp-system;
                                exp-backup: root.exp-backup;
                                exp-sync: root.exp-sync;
                                exp-tools: root.exp-tools;
                                design-theme-index: root.design-theme-index;
                                language-index: root.language-index;
                                font-renderer-index: root.font-renderer-index;
                                autostart-enabled: root.autostart-enabled;
                                isolation-index: root.isolation-index;
                                modules: root.modules;
                                backup-summary: root.backup-summary;
                                cloud-status: root.cloud-status;
                                backup-auto-upload: root.backup-auto-upload;
                                backup-encrypt-zip: root.backup-encrypt-zip;
                                backup-has-zip-pw: root.backup-has-zip-pw;
                                backup-busy: root.backup-busy;
                                webdav-servers: root.webdav-servers;
                                gh-repo <=> root.gh-repo;
                                gh-branch <=> root.gh-branch;
                                gh-include-in-backup: root.gh-include-in-backup;
                                gh-has-token: root.gh-has-token;
                                gh-status: root.gh-status;
                                sync-interval-index: root.sync-interval-index;
                                sync-status: root.sync-status;
                                sync-items: root.sync-items;
                                app-version: root.app-version;
                                diag-summary: root.diag-summary;
                                diag-verbose: root.diag-verbose;
                                diag-file-log: root.diag-file-log;
                                data-dir-text: root.data-dir-text;

                                toggle-section(id) => { root.dispatch("toggle_section", id); }
                                set-dark-mode(v) => { root.dispatch("set_dark_mode", v ? "1" : "0"); }
                                set-accent(i) => { root.dispatch("set_accent", "\{i}"); }
                                set-design-theme(i) => { root.dispatch("set_design_theme", "\{i}"); }
                                set-language(i) => { root.dispatch("set_language", "\{i}"); }
                                set-font-renderer(i) => { root.dispatch("set_font_renderer", "\{i}"); }
                                set-autostart(v) => { root.dispatch("set_autostart", v ? "1" : "0"); }
                                set-isolation(i) => { root.dispatch("set_isolation", "\{i}"); }
                                set-module-enabled(id, v) => { root.dispatch("set_module_enabled", "\{id}|\{v ? 1 : 0}"); }
                                restart-module(id) => { root.dispatch("restart_module", id); }
                                restart-all-modules => { root.dispatch("restart_all", ""); }
                                confirm-reset-all => { root.dispatch("reset_all", ""); }
                                backup-full-now => { root.dispatch("backup_full", ""); }
                                backup-settings-now => { root.dispatch("backup_settings", ""); }
                                upload-latest-backup => { root.dispatch("upload_latest", ""); }
                                open-backups-folder => { root.dispatch("open_backups_folder", ""); }
                                set-auto-upload(v) => { root.dispatch("set_auto_upload", v ? "1" : "0"); }
                                set-encrypt-zip(v) => { root.dispatch("set_encrypt_zip", v ? "1" : "0"); }
                                save-zip-password(p) => { root.dispatch("save_zip_pw", p); }
                                clear-zip-password => { root.dispatch("clear_zip_pw", ""); }
                                save-webdav-server(p, u, usr, pw, dir) => { root.save-webdav-server(p, u, usr, pw, dir); }
                                test-webdav-server(id) => { root.dispatch("test_webdav", id); }
                                delete-webdav-server(id) => { root.dispatch("delete_webdav", id); }
                                toggle-backup-target(id) => { root.dispatch("toggle_backup_target", id); }
                                toggle-sync-target(id) => { root.dispatch("toggle_sync_target", id); }
                                set-gh-include(v) => { root.dispatch("set_gh_include", v ? "1" : "0"); }
                                save-gh-settings(r, b, t) => { root.save-gh-settings(r, b, t); }
                                clear-gh-token => { root.dispatch("clear_gh_token", ""); }
                                download-gh-now => { root.dispatch("download_gh_now", ""); }
                                set-sync-interval(i) => { root.dispatch("set_sync_interval", "\{i}"); }
                                pick-sync-files => { root.dispatch("pick_sync_files", ""); }
                                pick-sync-folder => { root.dispatch("pick_sync_folder", ""); }
                                remove-sync-item(id) => { root.dispatch("remove_sync_item", id); }
                                sync-files-now => { root.dispatch("sync_files_now", ""); }
                                set-diag-verbose(v) => { root.dispatch("set_diag_verbose", v ? "1" : "0"); }
                                set-diag-file-log(v) => { root.dispatch("set_diag_file_log", v ? "1" : "0"); }
                                copy-diag-report => { root.dispatch("copy_diag_report", ""); }
                                save-diag-report => { root.dispatch("save_diag_report", ""); }
                                open-data-folder => { root.dispatch("open_data_folder", ""); }
                                copy-paths => { root.dispatch("copy_paths", ""); }
                                open-diagnostics => {
                                    root.active-tab = 4;
                                    scroll.viewport-y = 0px;
                                    root.dispatch("refresh_diag", "");
                                }
                                open-changelog => {
                                    root.active-tab = 5;
                                    scroll.viewport-y = 0px;
                                }
                            }

                            if (root.active-tab == 1) : SettingsDockView {
                                dock-names: root.dock-names;
                                selected-dock-index: root.selected-dock-index;
                                selected-dock-name: root.selected-dock-name;
                                can-remove-dock: root.can-remove-dock;
                                exp-appearance: root.exp-dock-appearance;
                                exp-behavior: root.exp-dock-behavior;
                                exp-items: root.exp-dock-items;
                                exp-menu: root.exp-dock-menu;
                                hi-appearance: root.hi-dock-appearance;
                                hi-behavior: root.hi-dock-behavior;
                                hi-items: root.hi-dock-items;
                                hi-menu: root.hi-dock-menu;
                                edge-index: root.dock-edge-index;
                                layer-index: root.dock-layer-index;
                                label-mode-index: root.dock-label-mode-index;
                                icon-size-px: root.dock-icon-size-px;
                                icon-frame-px: root.dock-icon-frame-px;
                                opacity-percent: root.dock-opacity-percent;
                                edge-margin-px: root.dock-edge-margin-px;
                                corner-radius-px: root.dock-corner-radius-px;
                                blur-enabled: root.dock-blur-enabled;
                                locked: root.dock-locked;
                                lock-items: root.dock-lock-items;
                                show-running: root.dock-show-running;
                                focus-running: root.dock-focus-running;
                                launch-anim: root.dock-launch-anim;
                                items: root.dock-items;
                                selected-item-id: root.dock-selected-item-id;
                                rename-input <=> root.dock-rename-input;
                                menu-open-folder: root.dock-menu-open-folder;
                                menu-launch: root.dock-menu-launch;
                                menu-remove: root.dock-menu-remove;
                                menu-add-dock: root.dock-menu-add-dock;

                                toggle-section(id) => { root.dispatch("toggle_section", id); }
                                select-dock(i) => { root.dispatch("select_dock", "\{i}"); }
                                add-dock => { root.dispatch("add_dock", ""); }
                                remove-current-dock => { root.dispatch("remove_dock", ""); }
                                open-docks-config => { root.dispatch("open_docks_cfg", ""); }
                                set-edge(i) => { root.dispatch("dock_edge", "\{i}"); }
                                set-layer(i) => { root.dispatch("dock_layer", "\{i}"); }
                                set-label-mode(i) => { root.dispatch("dock_label_mode", "\{i}"); }
                                set-icon-size(v) => { root.dispatch("dock_icon_size", "\{v}"); }
                                set-icon-frame(v) => { root.dispatch("dock_icon_frame", "\{v}"); }
                                set-opacity(v) => { root.dispatch("dock_opacity", "\{v}"); }
                                set-edge-margin(v) => { root.dispatch("dock_edge_margin", "\{v}"); }
                                set-corner-radius(v) => { root.dispatch("dock_corner_radius", "\{v}"); }
                                set-blur(v) => { root.dispatch("dock_blur", v ? "1" : "0"); }
                                set-locked(v) => { root.dispatch("dock_locked", v ? "1" : "0"); }
                                set-lock-items(v) => { root.dispatch("dock_lock_items", v ? "1" : "0"); }
                                set-show-running(v) => { root.dispatch("dock_show_running", v ? "1" : "0"); }
                                set-focus-running(v) => { root.dispatch("dock_focus_running", v ? "1" : "0"); }
                                set-launch-anim(v) => { root.dispatch("dock_launch_anim", v ? "1" : "0"); }
                                add-dock-files => { root.dispatch("dock_add_files", ""); }
                                add-dock-folder => { root.dispatch("dock_add_folder", ""); }
                                add-dock-separator => { root.dispatch("dock_add_sep", ""); }
                                select-dock-item(id, lbl) => {
                                    root.dock-selected-item-id = id;
                                    root.dock-rename-input = lbl;
                                    root.dispatch("dock_select_item", "\{id}");
                                }
                                rename-dock-item(id, lbl) => { root.dispatch("dock_rename_item", "\{id}|\{lbl}"); }
                                reset-dock-item-label(id) => { root.dispatch("dock_reset_item", "\{id}"); }
                                move-dock-item(id, d) => { root.dispatch("dock_move_item", "\{id}|\{d}"); }
                                open-dock-item-folder(id) => { root.dispatch("dock_open_item_folder", "\{id}"); }
                                remove-dock-item(id) => { root.dispatch("dock_remove_item", "\{id}"); }
                                toggle-dock-menu-vis(idx, v) => { root.dispatch("dock_menu_vis", "\{idx}|\{v ? 1 : 0}"); }
                            }

                            if (root.active-tab == 2) : SettingsWidgetsView {
                                selected-widget <=> root.selected-widget;
                                exp-cal: root.exp-cal;
                                exp-sys: root.exp-sys;
                                exp-weather: root.exp-weather;
                                exp-notes: root.exp-notes;
                                cal-visible: root.cal-visible;
                                cal-layer: root.cal-layer;
                                cal-period: root.cal-period;
                                cal-sync-idx: root.cal-sync-idx;
                                cal-opacity: root.cal-opacity;
                                cal-width: root.cal-width;
                                cal-rows: root.cal-rows;
                                cal-commented-hint: root.cal-commented-hint;
                                cal-sources: root.cal-sources;
                                sys-visible: root.sys-visible;
                                sys-layer: root.sys-layer;
                                sys-refresh-idx: root.sys-refresh-idx;
                                sys-opacity: root.sys-opacity;
                                sys-width: root.sys-width;
                                sys-height: root.sys-height;
                                weather-visible: root.weather-visible;
                                weather-city <=> root.weather-city;
                                weather-provider-idx: root.weather-provider-idx;
                                weather-days-idx: root.weather-days-idx;
                                weather-has-yandex-key: root.weather-has-yandex-key;
                                weather-layer: root.weather-layer;
                                weather-opacity: root.weather-opacity;
                                weather-refresh-min: root.weather-refresh-min;
                                weather-width: root.weather-width;
                                weather-height: root.weather-height;
                                notes-visible: root.notes-visible;
                                notes-layer: root.notes-layer;
                                notes-opacity: root.notes-opacity;
                                notes-pane-folders: root.notes-pane-folders;
                                notes-pane-list: root.notes-pane-list;
                                notes-pane-editor: root.notes-pane-editor;

                                toggle-section(id) => { root.dispatch("toggle_section", id); }
                                select-widget(i) => { root.selected-widget = i; }
                                set-cal-visible(v) => { root.dispatch("cal_visible", v ? "1" : "0"); }
                                set-cal-layer(i) => { root.dispatch("cal_layer", "\{i}"); }
                                set-cal-period(i) => { root.dispatch("cal_period", "\{i}"); }
                                set-cal-sync(i) => { root.dispatch("cal_sync", "\{i}"); }
                                set-cal-opacity(v) => { root.dispatch("cal_opacity", "\{v}"); }
                                set-cal-width(v) => { root.dispatch("cal_width", "\{v}"); }
                                set-cal-rows(v) => { root.dispatch("cal_rows", "\{v}"); }
                                refresh-cal => { root.dispatch("cal_refresh", ""); }
                                match-cal-to-sys => { root.dispatch("cal_match_sys", ""); }
                                add-cal-url(u) => { root.dispatch("cal_add_url", u); }
                                remove-cal-source(i) => { root.dispatch("cal_remove_src", "\{i}"); }
                                uncomment-cal => { root.dispatch("cal_uncomment", ""); }
                                open-cal-cfg => { root.dispatch("open_widgets_cfg", ""); }
                                set-sys-visible(v) => { root.dispatch("sys_visible", v ? "1" : "0"); }
                                set-sys-layer(i) => { root.dispatch("sys_layer", "\{i}"); }
                                set-sys-refresh(i) => { root.dispatch("sys_refresh", "\{i}"); }
                                set-sys-opacity(v) => { root.dispatch("sys_opacity", "\{v}"); }
                                set-sys-width(v) => { root.dispatch("sys_width", "\{v}"); }
                                set-sys-height(v) => { root.dispatch("sys_height", "\{v}"); }
                                refresh-sys => { root.dispatch("sys_refresh_now", ""); }
                                match-sys-to-cal => { root.dispatch("sys_match_cal", ""); }
                                open-sys-cfg => { root.dispatch("open_sysmon_cfg", ""); }
                                set-weather-visible(v) => { root.dispatch("weather_visible", v ? "1" : "0"); }
                                set-weather-provider(i) => { root.dispatch("weather_provider", "\{i}"); }
                                set-weather-days(i) => { root.dispatch("weather_days", "\{i}"); }
                                apply-weather-city(c) => { root.dispatch("weather_city", c); }
                                save-yandex-key(k) => { root.dispatch("weather_save_key", k); }
                                clear-yandex-key => { root.dispatch("weather_clear_key", ""); }
                                set-weather-layer(i) => { root.dispatch("weather_layer", "\{i}"); }
                                set-weather-opacity(v) => { root.dispatch("weather_opacity", "\{v}"); }
                                set-weather-refresh(v) => { root.dispatch("weather_refresh_min", "\{v}"); }
                                set-weather-width(v) => { root.dispatch("weather_width", "\{v}"); }
                                set-weather-height(v) => { root.dispatch("weather_height", "\{v}"); }
                                refresh-weather => { root.dispatch("weather_refresh_now", ""); }
                                open-weather-cfg => { root.dispatch("open_weather_cfg", ""); }
                                set-notes-visible(v) => { root.dispatch("notes_visible", v ? "1" : "0"); }
                                set-notes-layer(i) => { root.dispatch("notes_layer", "\{i}"); }
                                set-notes-opacity(v) => { root.dispatch("notes_opacity", "\{v}"); }
                                toggle-notes-pane(i) => { root.dispatch("notes_toggle_pane", "\{i}"); }
                                open-notes-folder => { root.dispatch("open_notes_folder", ""); }
                            }

                            if (root.active-tab == 3) : SettingsOverlayView {
                                exp-mode: root.exp-overlay-mode;
                                exp-layout: root.exp-overlay-layout;
                                hi-mode: root.hi-overlay-mode;
                                hi-layout: root.hi-overlay-layout;
                                module-enabled: root.ov-module-enabled;
                                auto-games-only: root.ov-auto-games-only;
                                force-topmost: root.ov-force-topmost;
                                setup-mode: root.ov-setup-mode;
                                anchor-index: root.ov-anchor-index;
                                opacity-percent: root.ov-opacity;
                                width-px: root.ov-width;
                                height-px: root.ov-height;
                                refresh-ms: root.ov-refresh-ms;

                                toggle-section(id) => { root.dispatch("toggle_section", id); }
                                set-module-enabled(v) => { root.dispatch("set_module_enabled", "overlay|\{v ? 1 : 0}"); }
                                set-auto-games-only(v) => { root.dispatch("ov_auto_games", v ? "1" : "0"); }
                                set-force-topmost(v) => { root.dispatch("ov_force_topmost", v ? "1" : "0"); }
                                set-setup-mode(v) => { root.dispatch("ov_setup_mode", v ? "1" : "0"); }
                                set-anchor(i) => { root.dispatch("ov_anchor", "\{i}"); }
                                set-opacity(v) => { root.dispatch("ov_opacity", "\{v}"); }
                                set-width(v) => { root.dispatch("ov_width", "\{v}"); }
                                set-height(v) => { root.dispatch("ov_height", "\{v}"); }
                                set-refresh-ms(v) => { root.dispatch("ov_refresh_ms", "\{v}"); }
                                apply-size-preset(w, h) => { root.dispatch("ov_preset", "\{w}|\{h}"); }
                                open-overlay-cfg => { root.dispatch("open_overlay_cfg", ""); }
                            }

                            if (root.active-tab == 4) : SettingsDiagnosticsView {
                                diag-summary: root.diag-summary;
                                diag-monitor-enabled: root.diag-monitor-enabled;
                                diag-verbose: root.diag-verbose;
                                diag-file-log: root.diag-file-log;
                                diag-filter-label: root.diag-filter-label;
                                modules: root.modules;
                                diag-logs: root.diag-logs;

                                toggle-monitor(v) => { root.dispatch("toggle_diag_monitor", v ? "1" : "0"); }
                                set-verbose(v) => { root.dispatch("set_diag_verbose", v ? "1" : "0"); }
                                set-file-log(v) => { root.dispatch("set_diag_file_log", v ? "1" : "0"); }
                                cycle-filter => { root.dispatch("cycle_diag_filter", ""); }
                                refresh-now => { root.dispatch("refresh_diag", ""); }
                                clear-logs => { root.dispatch("clear_diag_logs", ""); }
                                copy-report => { root.dispatch("copy_diag_report", ""); }
                                save-report => { root.dispatch("save_diag_report", ""); }
                                restart-module(id) => { root.dispatch("restart_module", id); }
                            }

                            if (root.active-tab == 5) : SettingsChangelogView {
                                app-version: root.app-version;
                                data-dir-text: root.data-dir-text;
                                exe-path-text: root.exe-path-text;
                                changelog-lines: root.changelog-lines;

                                open-data-folder => { root.dispatch("open_data_folder", ""); }
                                copy-paths => { root.dispatch("copy_paths", ""); }
                            }
                        }
                    }
                }
            }
        }

        WindowResizeHandles {
            resize-window(dir) => { root.resize-window(dir); }
        }
    }
}
