import { Theme, SlintTrayDockRow } from "theme.slint";
import { AsrGlassLogo } from "components/asr_logo.slint";
import {
    VectorIconChevron,
    VectorIconClose,
    VectorIconGear,
    VectorIconNav,
    VectorIconRefresh,
    VectorIconTheme,
} from "components/window_chrome.slint";

component TrayQuickBtn inherits Rectangle {
    in property <int> icon-kind: 0; // 0=gear, 1=refresh, 2=theme, 3=close
    in property <bool> danger: false;
    callback clicked();

    width: 28px;
    height: 28px;
    border-radius: 7px;
    background: ta.pressed
        ? (root.danger ? #C42B1C : Theme.press-bg)
        : (ta.has-hover
            ? (root.danger ? Theme.danger : Theme.hover-bg)
            : (root.danger ? rgba(232, 17, 35, 0.16) : Theme.card-bg));
    border-width: 1px;
    border-color: ta.has-hover
        ? (root.danger ? Theme.danger : Theme.border-strong)
        : (root.danger ? rgba(232, 17, 35, 0.36) : Theme.border-color);
    animate background { duration: 120ms; }

    if (root.icon-kind == 0) : VectorIconGear {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        size: 14px;
        icon-color: Theme.text-primary;
    }

    if (root.icon-kind == 1) : VectorIconRefresh {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        size: 14px;
        icon-color: Theme.text-primary;
    }

    if (root.icon-kind == 2) : VectorIconTheme {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        size: 14px;
        dark-mode: Theme.dark-mode;
        icon-color: Theme.text-primary;
    }

    if (root.icon-kind == 3) : VectorIconClose {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        size: 11px;
        icon-color: (ta.has-hover || ta.pressed)
            ? #FFFFFF
            : (Theme.dark-mode ? #FCA5A5 : #DC2626);
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component TrayRowBtn inherits Rectangle {
    in property <int> icon-kind: -1; // -1=none, 0..8=VectorIconNav
    in property <string> label;
    in property <bool> expandable: false;
    in property <bool> expanded: false;
    in property <bool> active-dot: false;
    in property <bool> danger: false;
    in property <bool> indent: false;
    callback clicked();

    height: root.indent ? 27px : 31px;
    border-radius: 7px;
    background: ta.has-hover
        ? (root.danger ? Theme.danger : Theme.hover-bg)
        : transparent;
    animate background { duration: 110ms; }

    HorizontalLayout {
        padding-left: root.indent ? 24px : 10px;
        padding-right: 10px;
        spacing: 9px;
        alignment: stretch;

        if (root.icon-kind >= 0) : VerticalLayout {
            width: 16px;
            alignment: center;
            VectorIconNav {
                kind: root.icon-kind;
                size: 14px;
                icon-color: (ta.has-hover && root.danger)
                    ? #FFFFFF
                    : (root.danger ? Theme.danger : Theme.accent);
            }
        }

        Text {
            horizontal-stretch: 1;
            min-width: 0px;
            text: root.label;
            color: (ta.has-hover && root.danger) ? #FFFFFF : Theme.text-primary;
            font-size: root.indent ? 11.5px : 12.5px;
            font-weight: root.indent ? 400 : 500;
            vertical-alignment: center;
            overflow: elide;
        }

        if (root.active-dot) : VerticalLayout {
            alignment: center;
            Rectangle {
                width: 7px;
                height: 7px;
                border-radius: 3.5px;
                background: Theme.success;
            }
        }

        if (root.expandable) : VerticalLayout {
            alignment: center;
            VectorIconChevron {
                size: 11px;
                up: root.expanded;
                icon-color: Theme.text-muted;
            }
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component TrayMenuWindow inherits Window {
    title: "asrbox — Трей";
    no-frame: true;
    background: transparent;
    default-font-family: "Segoe UI";
    preferred-width: 284px;
    preferred-height: 360px;

    in property <string> app-version: "0.2.0";
    in property <bool> dock-module-enabled: true;
    in property <bool> widgets-module-enabled: true;
    in property <bool> overlay-module-enabled: false;
    in property <bool> overlay-setup-mode: false;
    in property <bool> calendar-visible: true;
    in property <bool> sysmon-visible: true;
    in property <bool> weather-visible: true;
    in property <bool> notes-visible: false;
    in property <bool> autostart-enabled: false;
    in property <[SlintTrayDockRow]> docks: [];

    // TrayMenuVisibility flags
    in property <bool> vis-autostart: true;
    in property <bool> vis-docks: true;
    in property <bool> vis-widgets: true;
    in property <bool> vis-overlay: true;
    in property <bool> vis-backup: true;
    in property <bool> vis-debug: true;
    in property <bool> vis-about: true;

    in-out property <int> expanded-section: 0; // 0=none, 1=docks, 2=widgets, 3=overlay, 4=backup

    callback trigger-action(string, int);
    callback toggle-theme();
    callback section-changed(int);
    callback hide-menu();

    FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(ev) => {
            if (ev.text == Key.Escape) {
                root.hide-menu();
                return EventResult.accept;
            }
            EventResult.reject
        }

        Rectangle {
            width: 100%;
            height: 100%;
            border-radius: 8px;
            background: Theme.popup-bg;
            border-width: 1px;
            border-color: Theme.border-strong;
            clip: true;

            Rectangle {
                y: 0px;
                width: 100%;
                height: 1px;
                background: Theme.top-shine;
            }

            VerticalLayout {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                padding: 8px;
                spacing: 5px;

                // Top Quick-Action Bar (matches Concentric Fluent Glass spec)
                HorizontalLayout {
                    height: 36px;
                    padding-left: 4px;
                    padding-right: 2px;
                    spacing: 6px;
                    alignment: stretch;

                    VerticalLayout {
                        alignment: center;
                        AsrGlassLogo { size: 24px; }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        min-width: 0px;
                        alignment: center;
                        spacing: 0px;
                        Text {
                            text: "asrbox";
                            color: Theme.text-primary;
                            font-size: 13px;
                            font-weight: 700;
                        }
                        Text {
                            text: "v" + root.app-version;
                            color: Theme.text-muted;
                            font-size: 10px;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        TrayQuickBtn {
                            icon-kind: 0;
                            clicked => { root.trigger-action("open_settings", 0); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        TrayQuickBtn {
                            icon-kind: 1;
                            clicked => { root.trigger-action("refresh_all", 0); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        TrayQuickBtn {
                            icon-kind: 2;
                            clicked => { root.toggle-theme(); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        TrayQuickBtn {
                            icon-kind: 3;
                            danger: true;
                            clicked => { root.trigger-action("exit", 0); }
                        }
                    }
                }

                Rectangle { height: 1px; background: Theme.divider-color; }

                // Scrollable menu body
                Flickable {
                    vertical-stretch: 1;
                    content-width: self.width;
                    content-height: body-col.preferred-height;

                    body-col := VerticalLayout {
                        width: parent.width;
                        spacing: 2px;

                        TrayRowBtn {
                            icon-kind: 0;
                            label: "Настройки";
                            clicked => { root.trigger-action("open_settings", 0); }
                        }

                        // Docks expandable section
                        if (root.vis-docks) : TrayRowBtn {
                            icon-kind: 1;
                            label: "Док-панели";
                            active-dot: root.dock-module-enabled;
                            expandable: true;
                            expanded: root.expanded-section == 1;
                            clicked => {
                                root.expanded-section = root.expanded-section == 1 ? 0 : 1;
                                root.section-changed(root.expanded-section);
                            }
                        }
                        if (root.vis-docks && root.expanded-section == 1) : VerticalLayout {
                            spacing: 1px;
                            TrayRowBtn {
                                indent: true;
                                label: root.dock-module-enabled ? "Отключить модуль доков" : "Включить модуль доков";
                                active-dot: root.dock-module-enabled;
                                clicked => { root.trigger-action("toggle_dock_module", 0); }
                            }
                            for d in root.docks : TrayRowBtn {
                                indent: true;
                                label: d.title;
                                active-dot: d.enabled;
                                clicked => { root.trigger-action("toggle_dock", d.id); }
                            }
                            TrayRowBtn {
                                indent: true;
                                label: "+ Добавить док-панель";
                                clicked => { root.trigger-action("add_dock", 0); }
                            }
                            TrayRowBtn {
                                indent: true;
                                label: "Открыть docks.cfg";
                                clicked => { root.trigger-action("open_dock_cfg", 0); }
                            }
                        }

                        // Widgets expandable section
                        if (root.vis-widgets) : TrayRowBtn {
                            icon-kind: 2;
                            label: "Виджеты";
                            active-dot: root.widgets-module-enabled;
                            expandable: true;
                            expanded: root.expanded-section == 2;
                            clicked => {
                                root.expanded-section = root.expanded-section == 2 ? 0 : 2;
                                root.section-changed(root.expanded-section);
                            }
                        }
                        if (root.vis-widgets && root.expanded-section == 2) : VerticalLayout {
                            spacing: 1px;
                            TrayRowBtn {
                                indent: true;
                                label: root.widgets-module-enabled ? "Отключить модуль виджетов" : "Включить модуль виджетов";
                                active-dot: root.widgets-module-enabled;
                                clicked => { root.trigger-action("toggle_widgets_module", 0); }
                            }
                            TrayRowBtn {
                                indent: true;
                                label: "Погода";
                                active-dot: root.weather-visible;
                                clicked => { root.trigger-action("toggle_weather", 0); }
                            }
                            TrayRowBtn {
                                indent: true;
                                label: "Системный монитор";
                                active-dot: root.sysmon-visible;
                                clicked => { root.trigger-action("toggle_sysmon", 0); }
                            }
                            TrayRowBtn {
                                indent: true;
                                label: "Google Календарь";
                                active-dot: root.calendar-visible;
                                clicked => { root.trigger-action("toggle_calendar", 0); }
                            }
                            TrayRowBtn {
                                indent: true;
                                label: "Заметки";
                                active-dot: root.notes-visible;
                                clicked => { root.trigger-action("toggle_notes", 0); }
                            }
                        }

                        // Overlay expandable section
                        if (root.vis-overlay) : TrayRowBtn {
                            icon-kind: 3;
                            label: "Игровой оверлей";
                            active-dot: root.overlay-module-enabled;
                            expandable: true;
                            expanded: root.expanded-section == 3;
                            clicked => {
                                root.expanded-section = root.expanded-section == 3 ? 0 : 3;
                                root.section-changed(root.expanded-section);
                            }
                        }
                        if (root.vis-overlay && root.expanded-section == 3) : VerticalLayout {
                            spacing: 1px;
                            TrayRowBtn {
                                indent: true;
                                label: root.overlay-module-enabled ? "Выключить оверлей" : "Включить оверлей";
                                active-dot: root.overlay-module-enabled;
                                clicked => { root.trigger-action("toggle_overlay_module", 0); }
                            }
                            TrayRowBtn {
                                indent: true;
                                label: "Режим настройки позиции";
                                active-dot: root.overlay-setup-mode;
                                clicked => { root.trigger-action("toggle_overlay_setup", 0); }
                            }
                            TrayRowBtn {
                                indent: true;
                                label: "Параметры оверлея";
                                clicked => { root.trigger-action("open_overlay_tab", 0); }
                            }
                        }

                        // Backup expandable section
                        if (root.vis-backup) : TrayRowBtn {
                            icon-kind: 4;
                            label: "Бэкап и облако";
                            expandable: true;
                            expanded: root.expanded-section == 4;
                            clicked => {
                                root.expanded-section = root.expanded-section == 4 ? 0 : 4;
                                root.section-changed(root.expanded-section);
                            }
                        }
                        if (root.vis-backup && root.expanded-section == 4) : VerticalLayout {
                            spacing: 1px;
                            TrayRowBtn {
                                indent: true;
                                label: "Бэкап настроек сейчас";
                                clicked => { root.trigger-action("backup_settings", 0); }
                            }
                            TrayRowBtn {
                                indent: true;
                                label: "Полный бэкап сейчас";
                                clicked => { root.trigger-action("backup_full", 0); }
                            }
                            TrayRowBtn {
                                indent: true;
                                label: "Настройки облака";
                                clicked => { root.trigger-action("open_backup_tab", 0); }
                            }
                        }

                        Rectangle { height: 1px; background: Theme.divider-color; }

                        if (root.vis-autostart) : TrayRowBtn {
                            icon-kind: 5;
                            label: "Автозагрузка с Windows";
                            active-dot: root.autostart-enabled;
                            clicked => { root.trigger-action("toggle_autostart", 0); }
                        }

                        if (root.vis-debug) : TrayRowBtn {
                            icon-kind: 6;
                            label: "Диагностика и логи";
                            clicked => { root.trigger-action("open_debug", 0); }
                        }

                        if (root.vis-about) : TrayRowBtn {
                            icon-kind: 7;
                            label: "О программе";
                            clicked => { root.trigger-action("open_about", 0); }
                        }

                        Rectangle { height: 1px; background: Theme.divider-color; }

                        TrayRowBtn {
                            icon-kind: 8;
                            label: "Выход";
                            danger: true;
                            clicked => { root.trigger-action("exit", 0); }
                        }
                    }
                }
            }
        }
    }
}
