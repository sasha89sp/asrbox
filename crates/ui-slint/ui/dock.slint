import { Theme, SlintDockIconRow, SlintFolderEntryRow } from "theme.slint";
import { AsrGlassLogo } from "components/asr_logo.slint";
import { VectorIconFolder, VectorIconFile } from "components/window_chrome.slint";

component DockMenuBtn inherits Rectangle {
    in property <string> label;
    in property <bool> checked: false;
    in property <bool> danger: false;
    callback clicked();

    height: 27px;
    border-radius: 6px;
    background: ta.has-hover
        ? (root.danger ? Theme.danger : Theme.hover-bg)
        : (root.checked ? Theme.accent-tint : transparent);

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;

        Text {
            horizontal-stretch: 1;
            min-width: 0px;
            text: root.label;
            color: (ta.has-hover && root.danger) ? #FFFFFF : Theme.text-primary;
            font-size: 11.5px;
            font-weight: root.checked ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
        }

        if (root.checked) : Rectangle {
            width: 6px;
            height: 6px;
            y: (parent.height - self.height) / 2;
            border-radius: 3px;
            background: Theme.accent;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component DockFallbackBadge inherits Rectangle {
    in property <bool> is-folder: false;
    in property <length> size: 44px;

    width: root.size;
    height: root.size;
    border-radius: 9px;
    background: root.is-folder ? Theme.accent-tint : Theme.card-bg;
    border-width: 1px;
    border-color: root.is-folder ? Theme.accent : Theme.border-strong;

    if (root.is-folder) : VectorIconFolder {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        size: root.size * 0.56;
        icon-color: Theme.accent;
    }

    if (!root.is-folder) : VectorIconFile {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        size: root.size * 0.54;
        icon-color: Theme.accent;
    }
}

component DockDragGrip inherits Rectangle {
    in property <bool> vertical-dots: true;
    in property <color> dot-color: Theme.text-muted;
    width: root.vertical-dots ? 8px : 14px;
    height: root.vertical-dots ? 14px : 8px;
    background: transparent;

    if (root.vertical-dots) : VerticalLayout {
        spacing: 3px;
        alignment: center;
        for _row in [0, 1, 2] : HorizontalLayout {
            spacing: 3px;
            alignment: center;
            Rectangle { width: 2px; height: 2px; border-radius: 1px; background: root.dot-color; }
            Rectangle { width: 2px; height: 2px; border-radius: 1px; background: root.dot-color; }
        }
    }

    if (!root.vertical-dots) : HorizontalLayout {
        spacing: 3px;
        alignment: center;
        for _col in [0, 1, 2] : VerticalLayout {
            spacing: 3px;
            alignment: center;
            Rectangle { width: 2px; height: 2px; border-radius: 1px; background: root.dot-color; }
            Rectangle { width: 2px; height: 2px; border-radius: 1px; background: root.dot-color; }
        }
    }
}

component DockTile inherits Rectangle {
    in property <SlintDockIconRow> item;
    in property <length> icon-size: 44px;
    in property <int> label-mode: 0; // 0=IconsOnly, 1=Below, 2=Right, 3=Tooltip
    in property <bool> hover-zoom: true;
    in property <bool> show-running-dot: true;
    in property <bool> launch-anim: true;
    callback launched(int);
    callback right-clicked(int, bool, length, length);
    callback hovered(string);
    callback unhovered();

    private property <bool> bouncing: false;

    width: root.label-mode == 2 ? (root.icon-size + 96px) : (root.icon-size + 12px);
    height: root.label-mode == 1 ? (root.icon-size + 24px) : (root.icon-size + 12px);
    border-radius: 9px;
    background: ta.pressed
        ? Theme.press-bg
        : (ta.has-hover ? Theme.hover-bg : transparent);
    border-width: 1px;
    border-color: ta.has-hover ? Theme.border-strong : transparent;
    animate background { duration: 120ms; easing: ease-out; }

    ta := TouchArea {
        mouse-cursor: pointer;
        changed has-hover => {
            if (self.has-hover) {
                root.hovered(root.item.label);
            } else {
                root.unhovered();
            }
        }
        pointer-event(ev) => {
            if (ev.button == PointerEventButton.right && ev.kind == PointerEventKind.down) {
                root.right-clicked(root.item.id, root.item.is-separator, self.mouse-x, self.mouse-y);
            } else if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) {
                if (root.launch-anim) {
                    root.bouncing = true;
                }
            } else if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.up) {
                root.bouncing = false;
                root.launched(root.item.id);
            } else if (ev.kind == PointerEventKind.cancel) {
                root.bouncing = false;
            }
        }
    }

    if (root.label-mode == 2) : HorizontalLayout {
        padding-left: 6px;
        padding-right: 8px;
        spacing: 8px;
        alignment: start;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: root.icon-size;
                height: root.icon-size;
                background: transparent;

                if (root.item.has-icon) : Image {
                    width: (ta.has-hover && root.hover-zoom) ? root.icon-size * 1.06 : root.icon-size * 0.90;
                    height: (ta.has-hover && root.hover-zoom) ? root.icon-size * 1.06 : root.icon-size * 0.90;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2 + (root.bouncing ? -3px : 0px);
                    source: root.item.icon-img;
                    image-fit: contain;
                    animate width, height, y { duration: 120ms; easing: ease-out; }
                }

                if (!root.item.has-icon) : DockFallbackBadge {
                    is-folder: root.item.is-folder;
                    size: root.icon-size * 0.88;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2 + (root.bouncing ? -3px : 0px);
                }
            }
        }

        Text {
            horizontal-stretch: 1;
            min-width: 0px;
            text: root.item.label;
            color: Theme.text-primary;
            font-size: 11.5px;
            font-weight: 500;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    if (root.label-mode != 2) : VerticalLayout {
        padding: 4px;
        spacing: 2px;
        alignment: center;

        Rectangle {
            width: root.icon-size;
            height: root.icon-size;
            background: transparent;

            if (root.item.has-icon) : Image {
                width: (ta.has-hover && root.hover-zoom) ? root.icon-size * 1.08 : root.icon-size * 0.90;
                height: (ta.has-hover && root.hover-zoom) ? root.icon-size * 1.08 : root.icon-size * 0.90;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2
                    + (root.bouncing ? -4px : (ta.has-hover && root.hover-zoom ? -2px : 0px));
                source: root.item.icon-img;
                image-fit: contain;
                animate width, height, y { duration: 120ms; easing: ease-out; }
            }

            if (!root.item.has-icon) : DockFallbackBadge {
                is-folder: root.item.is-folder;
                size: root.icon-size * 0.88;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2
                    + (root.bouncing ? -4px : (ta.has-hover && root.hover-zoom ? -2px : 0px));
            }
        }

        if (root.label-mode == 1) : Text {
            width: root.icon-size + 6px;
            text: root.item.label;
            color: Theme.text-primary;
            font-size: 10px;
            horizontal-alignment: center;
            overflow: elide;
        }
    }

    // Running-app indicator bar
    if (root.show-running-dot && root.item.is-running) : Rectangle {
        x: (parent.width - 12px) / 2;
        y: parent.height - 4px;
        width: 12px;
        height: 3px;
        border-radius: 1.5px;
        background: Theme.accent;
    }
}

export component DockWindow inherits Window {
    title: "asrbox — Док";
    no-frame: true;
    background: transparent;
    preferred-width: 480px;
    preferred-height: 76px;

    in property <string> dock-name: "Док 1";
    in property <bool> is-horizontal: true;
    in property <length> icon-size: 44px;
    in property <length> item-spacing: 6px;
    in property <length> dock-padding: 8px;
    in property <length> corner-radius: 8px;
    in property <int> opacity-pct: 85;
    in property <int> edge-index: 3; // 0=Left, 1=Right, 2=Top, 3=Bottom
    in property <int> layer-index: 0; // 0=Wallpaper, 1=Normal, 2=Topmost
    in property <int> label-mode: 0;
    in property <bool> locked: true;
    in property <bool> lock-items: false;
    in property <bool> hover-zoom: true;
    in property <bool> show-running-dot: true;
    in property <bool> focus-running: true;
    in property <bool> launch-anim: true;
    in property <bool> show-settings-button: true;
    in property <bool> can-remove-dock: false;
    in property <[SlintDockIconRow]> items: [];

    // Folder Fan-Out popup state
    in property <string> folder-title: "";
    in property <string> folder-path: "";
    in property <[SlintFolderEntryRow]> folder-entries: [];

    // Menu visibility flags (from menus.cfg)
    in property <bool> vis-item-actions: true;
    in property <bool> vis-add-separator: true;
    in property <bool> vis-edge-layer: true;
    in property <bool> vis-appearance: true;
    in property <bool> vis-behavior: true;
    in property <bool> vis-lock: true;
    in property <bool> vis-dock-mgmt: true;

    callback drag-window();
    callback launch-item(int);
    callback launch-folder-entry(string);
    callback open-folder-explorer(string);
    callback open-settings();
    callback menu-action(string, int);

    public function open-folder-popup() {
        folder-popup.show();
    }

    private property <int> ctx-item-id: -1;
    private property <bool> ctx-item-is-sep: false;
    private property <length> ctx-x: 16px;
    private property <length> ctx-y: 12px;
    private property <string> hover-tip: "";

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 8px;
        background: Theme.window-bg;
        border-width: 1px;
        border-color: Theme.border-strong;
        clip: true;

        // Top specular glass highlight
        Rectangle {
            y: 0px;
            width: 100%;
            height: 1px;
            background: Theme.top-shine;
        }

        // Background drag (when unlocked) + right-click context menu
        TouchArea {
            pointer-event(ev) => {
                if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down && !root.locked) {
                    root.drag-window();
                } else if (ev.button == PointerEventButton.right && ev.kind == PointerEventKind.down) {
                    root.ctx-item-id = -1;
                    root.ctx-item-is-sep = false;
                    root.ctx-x = Math.clamp(self.mouse-x, 4px, Math.max(4px, root.width - 216px));
                    root.ctx-y = 4px;
                    ctx-menu.show();
                }
            }
        }

        // Horizontal capsule layout
        if (root.is-horizontal) : HorizontalLayout {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 100%;
            padding: root.dock-padding;
            spacing: root.item-spacing;
            alignment: center;

            if (!root.locked) : Rectangle {
                width: 16px;
                height: root.icon-size + 8px;
                border-radius: 6px;
                background: drag-ta.has-hover ? Theme.hover-bg : transparent;

                DockDragGrip {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    vertical-dots: true;
                    dot-color: drag-ta.has-hover ? Theme.text-primary : Theme.text-muted;
                }

                drag-ta := TouchArea {
                    mouse-cursor: grab;
                    pointer-event(ev) => {
                        if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) {
                            root.drag-window();
                        }
                    }
                }
            }

            for it in root.items : Rectangle {
                width: it.is-separator ? 10px
                    : (root.label-mode == 2 ? (root.icon-size + 96px) : (root.icon-size + 12px));
                height: root.label-mode == 1 ? (root.icon-size + 24px) : (root.icon-size + 12px);
                background: transparent;

                if (it.is-separator) : Rectangle {
                    x: 4px;
                    y: (parent.height - root.icon-size * 0.65) / 2;
                    width: 2px;
                    height: root.icon-size * 0.65;
                    border-radius: 1px;
                    background: Theme.border-strong;

                    TouchArea {
                        pointer-event(ev) => {
                            if (ev.button == PointerEventButton.right && ev.kind == PointerEventKind.down) {
                                root.ctx-item-id = it.id;
                                root.ctx-item-is-sep = true;
                                root.ctx-x = 12px;
                                root.ctx-y = 4px;
                                ctx-menu.show();
                            }
                        }
                    }
                }

                if (!it.is-separator) : DockTile {
                    item: it;
                    icon-size: root.icon-size;
                    label-mode: root.label-mode;
                    hover-zoom: root.hover-zoom;
                    show-running-dot: root.show-running-dot;
                    launch-anim: root.launch-anim;
                    launched(id) => { root.launch-item(id); }
                    hovered(lbl) => { root.hover-tip = lbl; }
                    unhovered => { root.hover-tip = ""; }
                    right-clicked(id, sep, _mx, _my) => {
                        root.ctx-item-id = id;
                        root.ctx-item-is-sep = sep;
                        root.ctx-x = 12px;
                        root.ctx-y = 4px;
                        ctx-menu.show();
                    }
                }
            }

            if (root.show-settings-button) : Rectangle {
                width: root.icon-size + 12px;
                height: root.icon-size + 12px;
                border-radius: 9px;
                background: set-ta.has-hover ? Theme.hover-bg : transparent;
                border-width: 1px;
                border-color: set-ta.has-hover ? Theme.border-strong : transparent;

                AsrGlassLogo {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    size: root.icon-size * 0.88;
                }

                set-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.open-settings(); }
                    pointer-event(ev) => {
                        if (ev.button == PointerEventButton.right && ev.kind == PointerEventKind.down) {
                            root.ctx-item-id = -1;
                            root.ctx-item-is-sep = false;
                            root.ctx-x = Math.max(4px, root.width - 216px);
                            root.ctx-y = 4px;
                            ctx-menu.show();
                        }
                    }
                }
            }
        }

        // Vertical capsule layout
        if (!root.is-horizontal) : VerticalLayout {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 100%;
            padding: root.dock-padding;
            spacing: root.item-spacing;
            alignment: center;

            if (!root.locked) : Rectangle {
                width: root.icon-size + 8px;
                height: 16px;
                border-radius: 6px;
                background: vdrag-ta.has-hover ? Theme.hover-bg : transparent;

                DockDragGrip {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    vertical-dots: false;
                    dot-color: vdrag-ta.has-hover ? Theme.text-primary : Theme.text-muted;
                }

                vdrag-ta := TouchArea {
                    mouse-cursor: grab;
                    pointer-event(ev) => {
                        if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) {
                            root.drag-window();
                        }
                    }
                }
            }

            for it in root.items : Rectangle {
                width: root.label-mode == 2 ? (root.icon-size + 96px) : (root.icon-size + 12px);
                height: it.is-separator ? 10px
                    : (root.label-mode == 1 ? (root.icon-size + 24px) : (root.icon-size + 12px));
                background: transparent;

                if (it.is-separator) : Rectangle {
                    x: (parent.width - root.icon-size * 0.65) / 2;
                    y: 4px;
                    width: root.icon-size * 0.65;
                    height: 2px;
                    border-radius: 1px;
                    background: Theme.border-strong;

                    TouchArea {
                        pointer-event(ev) => {
                            if (ev.button == PointerEventButton.right && ev.kind == PointerEventKind.down) {
                                root.ctx-item-id = it.id;
                                root.ctx-item-is-sep = true;
                                root.ctx-x = 4px;
                                root.ctx-y = 12px;
                                ctx-menu.show();
                            }
                        }
                    }
                }

                if (!it.is-separator) : DockTile {
                    item: it;
                    icon-size: root.icon-size;
                    label-mode: root.label-mode;
                    hover-zoom: root.hover-zoom;
                    show-running-dot: root.show-running-dot;
                    launch-anim: root.launch-anim;
                    launched(id) => { root.launch-item(id); }
                    hovered(lbl) => { root.hover-tip = lbl; }
                    unhovered => { root.hover-tip = ""; }
                    right-clicked(id, sep, _mx, _my) => {
                        root.ctx-item-id = id;
                        root.ctx-item-is-sep = sep;
                        root.ctx-x = 4px;
                        root.ctx-y = 12px;
                        ctx-menu.show();
                    }
                }
            }

            if (root.show-settings-button) : Rectangle {
                width: root.icon-size + 12px;
                height: root.icon-size + 12px;
                border-radius: 9px;
                background: vset-ta.has-hover ? Theme.hover-bg : transparent;

                AsrGlassLogo {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    size: root.icon-size * 0.88;
                }

                vset-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.open-settings(); }
                    pointer-event(ev) => {
                        if (ev.button == PointerEventButton.right && ev.kind == PointerEventKind.down) {
                            root.ctx-item-id = -1;
                            root.ctx-item-is-sep = false;
                            root.ctx-x = 4px;
                            root.ctx-y = 12px;
                            ctx-menu.show();
                        }
                    }
                }
            }
        }

        // Glass Hover Tooltip overlay (active in IconsOnly=0 and Tooltip=3 modes)
        if ((root.label-mode == 3 || root.label-mode == 0) && root.hover-tip != "") : Rectangle {
            x: (parent.width - self.width) / 2;
            y: 3px;
            height: 19px;
            max-width: parent.width - 16px;
            border-radius: 5px;
            background: Theme.popup-bg;
            border-width: 1px;
            border-color: Theme.border-strong;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                Text {
                    text: root.hover-tip;
                    color: Theme.text-primary;
                    font-size: 10.5px;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }

    // Concentric Fluent Glass Folder Fan-Out Popup
    folder-popup := PopupWindow {
        x: Math.clamp((root.width - 300px) / 2, 4px, Math.max(4px, root.width - 304px));
        y: root.edge-index == 2 ? root.height + 4px : 4px;
        width: 300px;
        close-policy: PopupClosePolicy.close-on-click-outside;

        Rectangle {
            border-radius: 10px;
            background: Theme.popup-bg;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 20px;
            drop-shadow-color: rgba(0, 0, 0, 0.48);
            drop-shadow-offset-y: 8px;

            VerticalLayout {
                padding: 8px;
                spacing: 6px;

                HorizontalLayout {
                    height: 26px;
                    spacing: 6px;
                    alignment: stretch;

                    VerticalLayout {
                        alignment: center;
                        VectorIconFolder { size: 14px; icon-color: Theme.accent; }
                    }

                    Text {
                        horizontal-stretch: 1;
                        min-width: 0px;
                        text: root.folder-title;
                        color: Theme.text-primary;
                        font-size: 12px;
                        font-weight: 700;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    Rectangle {
                        height: 22px;
                        border-radius: 5px;
                        background: exp-ta.has-hover ? Theme.accent-hover : Theme.accent-tint;
                        border-width: 1px;
                        border-color: Theme.accent;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            Text {
                                text: "Проводник";
                                color: exp-ta.has-hover ? #FFFFFF : Theme.accent;
                                font-size: 10.5px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }

                        exp-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                folder-popup.close();
                                root.open-folder-explorer(root.folder-path);
                            }
                        }
                    }
                }

                Rectangle { height: 1px; background: Theme.divider-color; }

                if (root.folder-entries.length == 0) : Rectangle {
                    height: 36px;
                    background: transparent;
                    Text {
                        width: 100%;
                        height: 100%;
                        text: "Папка пуста";
                        color: Theme.text-muted;
                        font-size: 11.5px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                if (root.folder-entries.length > 0) : Flickable {
                    height: Math.min(264px, root.folder-entries.length * 32px);
                    content-width: self.width;
                    content-height: f-col.preferred-height;

                    f-col := VerticalLayout {
                        width: parent.width;
                        spacing: 2px;

                        for entry in root.folder-entries : Rectangle {
                            height: 30px;
                            border-radius: 6px;
                            background: fe-ta.has-hover ? Theme.hover-bg : transparent;

                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 8px;
                                spacing: 8px;
                                alignment: stretch;

                                VerticalLayout {
                                    alignment: center;
                                    width: 20px;

                                    if (entry.has-icon) : Image {
                                        width: 18px;
                                        height: 18px;
                                        source: entry.icon-img;
                                        image-fit: contain;
                                    }

                                    if (!entry.has-icon && entry.is-dir) : VectorIconFolder {
                                        size: 15px;
                                        icon-color: Theme.accent;
                                    }

                                    if (!entry.has-icon && !entry.is-dir) : VectorIconFile {
                                        size: 14px;
                                        icon-color: Theme.text-secondary;
                                    }
                                }

                                Text {
                                    horizontal-stretch: 1;
                                    min-width: 0px;
                                    text: entry.name;
                                    color: Theme.text-primary;
                                    font-size: 11.5px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }

                            fe-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    folder-popup.close();
                                    root.launch-folder-entry(entry.path);
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Slint PopupWindow context menu (auto-closes on outside click / Esc)
    ctx-menu := PopupWindow {
        x: root.ctx-x;
        y: root.ctx-y;
        width: 214px;
        close-policy: PopupClosePolicy.close-on-click-outside;

        Rectangle {
            border-radius: 10px;
            background: Theme.popup-bg;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 18px;
            drop-shadow-color: rgba(0, 0, 0, 0.45);
            drop-shadow-offset-y: 6px;

            VerticalLayout {
                padding: 5px;
                spacing: 2px;

                if (root.ctx-item-id >= 0 && root.vis-item-actions && !root.ctx-item-is-sep) : DockMenuBtn {
                    label: "Открыть расположение";
                    clicked => { ctx-menu.close(); root.menu-action("open_item_folder", root.ctx-item-id); }
                }
                if (root.ctx-item-id >= 0 && root.vis-item-actions && !root.ctx-item-is-sep) : DockMenuBtn {
                    label: "Выбрать иконку…";
                    clicked => { ctx-menu.close(); root.menu-action("choose_icon", root.ctx-item-id); }
                }
                if (root.ctx-item-id >= 0 && root.vis-item-actions && !root.ctx-item-is-sep) : DockMenuBtn {
                    label: "Сбросить иконку";
                    clicked => { ctx-menu.close(); root.menu-action("reset_icon", root.ctx-item-id); }
                }
                if (root.ctx-item-id >= 0 && root.vis-item-actions && !root.lock-items) : HorizontalLayout {
                    height: 26px;
                    spacing: 4px;
                    DockMenuBtn {
                        horizontal-stretch: 1;
                        label: "< Сдвинуть";
                        clicked => { ctx-menu.close(); root.menu-action("move_prev", root.ctx-item-id); }
                    }
                    DockMenuBtn {
                        horizontal-stretch: 1;
                        label: "Сдвинуть >";
                        clicked => { ctx-menu.close(); root.menu-action("move_next", root.ctx-item-id); }
                    }
                }
                if (root.ctx-item-id >= 0 && root.vis-item-actions && !root.lock-items) : DockMenuBtn {
                    label: root.ctx-item-is-sep ? "Удалить разделитель" : "Удалить значок";
                    danger: true;
                    clicked => { ctx-menu.close(); root.menu-action("remove_item", root.ctx-item-id); }
                }
                if (root.ctx-item-id >= 0 && root.vis-item-actions) : Rectangle {
                    height: 1px;
                    background: Theme.divider-color;
                }

                if (root.vis-add-separator && !root.lock-items) : DockMenuBtn {
                    label: "Добавить разделитель";
                    clicked => { ctx-menu.close(); root.menu-action("add_separator", 0); }
                }

                if (root.vis-edge-layer) : HorizontalLayout {
                    height: 25px;
                    padding-left: 4px;
                    padding-right: 4px;
                    spacing: 3px;
                    for e[idx] in ["Лево", "Право", "Верх", "Низ"] : Rectangle {
                        horizontal-stretch: 1;
                        border-radius: 5px;
                        background: root.edge-index == idx ? Theme.accent : Theme.card-bg;
                        Text {
                            width: 100%;
                            height: 100%;
                            text: e;
                            color: root.edge-index == idx ? #FFFFFF : Theme.text-primary;
                            font-size: 10px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { ctx-menu.close(); root.menu-action("set_edge", idx); }
                        }
                    }
                }
                if (root.vis-edge-layer) : HorizontalLayout {
                    height: 25px;
                    padding-left: 4px;
                    padding-right: 4px;
                    spacing: 3px;
                    for l[idx] in ["Обои", "Обычн.", "Поверх"] : Rectangle {
                        horizontal-stretch: 1;
                        border-radius: 5px;
                        background: root.layer-index == idx ? Theme.accent : Theme.card-bg;
                        Text {
                            width: 100%;
                            height: 100%;
                            text: l;
                            color: root.layer-index == idx ? #FFFFFF : Theme.text-primary;
                            font-size: 10px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { ctx-menu.close(); root.menu-action("set_layer", idx); }
                        }
                    }
                }

                if (root.vis-appearance) : HorizontalLayout {
                    height: 25px;
                    padding-left: 4px;
                    padding-right: 4px;
                    spacing: 3px;
                    for sz in [40, 48, 64] : Rectangle {
                        horizontal-stretch: 1;
                        border-radius: 5px;
                        background: root.icon-size == sz * 1px ? Theme.accent : Theme.card-bg;
                        Text {
                            width: 100%;
                            height: 100%;
                            text: "\{sz}px";
                            color: root.icon-size == sz * 1px ? #FFFFFF : Theme.text-primary;
                            font-size: 10px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { ctx-menu.close(); root.menu-action("icon_size", sz); }
                        }
                    }
                }
                if (root.vis-appearance) : DockMenuBtn {
                    label: "Режим подписей (цикл)";
                    clicked => { ctx-menu.close(); root.menu-action("cycle_labels", 0); }
                }

                if (root.vis-behavior) : DockMenuBtn {
                    label: "Увеличение при наведении";
                    checked: root.hover-zoom;
                    clicked => { ctx-menu.close(); root.menu-action("toggle_hover_zoom", 0); }
                }
                if (root.vis-behavior) : DockMenuBtn {
                    label: "Точка запущенных окон";
                    checked: root.show-running-dot;
                    clicked => { ctx-menu.close(); root.menu-action("toggle_running_dot", 0); }
                }

                if (root.vis-lock) : Rectangle { height: 1px; background: Theme.divider-color; }
                if (root.vis-lock) : DockMenuBtn {
                    label: "Закрепить положение";
                    checked: root.locked;
                    clicked => { ctx-menu.close(); root.menu-action("toggle_lock", 0); }
                }
                if (root.vis-lock) : DockMenuBtn {
                    label: "Защита значков от удаления";
                    checked: root.lock-items;
                    clicked => { ctx-menu.close(); root.menu-action("toggle_lock_items", 0); }
                }

                if (root.vis-dock-mgmt) : Rectangle { height: 1px; background: Theme.divider-color; }
                if (root.vis-dock-mgmt) : DockMenuBtn {
                    label: "Настройки док-панелей";
                    clicked => { ctx-menu.close(); root.open-settings(); }
                }
                if (root.vis-dock-mgmt) : DockMenuBtn {
                    label: "Добавить новую панель";
                    clicked => { ctx-menu.close(); root.menu-action("add_dock", 0); }
                }
                if (root.vis-dock-mgmt && root.can-remove-dock) : DockMenuBtn {
                    label: "Удалить эту панель";
                    danger: true;
                    clicked => { ctx-menu.close(); root.menu-action("remove_dock", 0); }
                }
            }
        }
    }
}
