import { Theme, SlintWeatherHourRow, SlintWeatherDayRow } from "theme.slint";
import {
    VectorIconGear,
    VectorIconRefresh,
    WindowResizeHandles,
} from "components/window_chrome.slint";

component WeatherMetricPill inherits Rectangle {
    in property <string> title;
    in property <string> value;

    horizontal-stretch: 1;
    height: 44px;
    border-radius: 8px;
    background: Theme.card-bg;
    border-width: 1px;
    border-color: Theme.border-color;

    VerticalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 5px;
        padding-bottom: 5px;
        alignment: center;
        spacing: 2px;

        Text {
            text: root.title;
            color: Theme.text-secondary;
            font-size: 10px;
            horizontal-alignment: center;
        }

        Text {
            text: root.value;
            color: Theme.text-primary;
            font-size: 12px;
            font-weight: 600;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
}

export component WeatherWindow inherits Window {
    title: "asrbox — Погода";
    no-frame: true;
    background: transparent;
    preferred-width: 344px;
    preferred-height: 404px;
    min-width: 280px;
    min-height: 310px;

    in property <string> city-name: "Москва";
    in property <string> provider-label: "Open-Meteo";
    in property <string> date-subtitle: "";
    in property <string> temp-text: "--°";
    in property <string> condition-glyph: "⛅";
    in property <string> condition-text: "Загрузка…";
    in property <string> feels-like-text: "Ощущается как --°";
    in property <string> wind-text: "-- м/с";
    in property <string> humidity-text: "--%";
    in property <string> pressure-text: "-- мм";
    in property <int> forecast-days: 3;
    in property <[SlintWeatherHourRow]> hourly-rows: [];
    in property <[SlintWeatherDayRow]> daily-rows: [];
    in property <string> footer-text: "";
    in property <string> error-text: "";
    in property <bool> loading: false;

    callback drag-window();
    callback resize-window(int);
    callback open-settings();
    callback refresh-now();
    callback set-forecast-days(int);
    callback open-context-menu();

    shell := Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 8px;
        background: Theme.window-bg;
        border-width: 1px;
        border-color: Theme.border-strong;
        clip: true;

        // Top specular glass highlight
        Rectangle {
            y: 0px;
            width: 100%;
            height: 1px;
            background: Theme.top-shine;
        }

        // Right-click capture layer across entire widget
        TouchArea {
            pointer-event(ev) => {
                if (ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up) {
                    root.open-context-menu();
                }
            }
        }

        VerticalLayout {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 100%;
            padding: 12px;
            spacing: 8px;

            // Header bar (draggable)
            Rectangle {
                height: 30px;
                background: transparent;

                TouchArea {
                    pointer-event(ev) => {
                        if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) {
                            root.drag-window();
                        } else if (ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up) {
                            root.open-context-menu();
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    alignment: stretch;

                    VerticalLayout {
                        horizontal-stretch: 1;
                        min-width: 0px;
                        alignment: center;
                        spacing: 1px;

                        Text {
                            min-width: 0px;
                            text: root.city-name;
                            color: Theme.text-primary;
                            font-size: 14px;
                            font-weight: 700;
                            overflow: elide;
                        }

                        if (root.date-subtitle != "") : Text {
                            min-width: 0px;
                            text: root.date-subtitle;
                            color: Theme.text-secondary;
                            font-size: 10.5px;
                            overflow: elide;
                        }
                    }

                    Rectangle {
                        width: 26px;
                        height: 26px;
                        border-radius: 6px;
                        background: set-ta.has-hover ? Theme.hover-bg : transparent;
                        VectorIconGear {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            size: 14px;
                            icon-color: set-ta.has-hover ? Theme.text-primary : Theme.text-secondary;
                        }
                        set-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.open-settings(); }
                        }
                    }

                    Rectangle {
                        width: 26px;
                        height: 26px;
                        border-radius: 6px;
                        background: ref-ta.has-hover ? Theme.hover-bg : transparent;
                        VectorIconRefresh {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            size: 14px;
                            icon-color: root.loading ? Theme.accent
                                : (ref-ta.has-hover ? Theme.text-primary : Theme.text-secondary);
                        }
                        ref-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.refresh-now(); }
                        }
                    }
                }
            }

            // Hero temperature & condition
            HorizontalLayout {
                spacing: 10px;
                height: 54px;
                alignment: stretch;

                Text {
                    text: root.temp-text;
                    color: Theme.text-primary;
                    font-size: 38px;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    alignment: center;
                    spacing: 2px;

                    Text {
                        min-width: 0px;
                        text: root.condition-text;
                        color: Theme.text-primary;
                        font-size: 13px;
                        font-weight: 600;
                        overflow: elide;
                    }

                    Text {
                        min-width: 0px;
                        text: root.feels-like-text;
                        color: Theme.text-secondary;
                        font-size: 11px;
                        overflow: elide;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 44px;
                        height: 44px;
                        border-radius: 12px;
                        background: Theme.accent-tint;
                        border-width: 1px;
                        border-color: Theme.border-color;

                        Text {
                            width: 100%;
                            height: 100%;
                            text: root.condition-glyph;
                            font-size: 24px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // 3 Metric pills
            HorizontalLayout {
                spacing: 6px;
                WeatherMetricPill { title: "Ветер"; value: root.wind-text; }
                WeatherMetricPill { title: "Влажность"; value: root.humidity-text; }
                WeatherMetricPill { title: "Давление"; value: root.pressure-text; }
            }

            // Hourly 5-slot strip
            if (root.hourly-rows.length > 0) : Rectangle {
                height: 58px;
                border-radius: 9px;
                background: Theme.card-bg;
                border-width: 1px;
                border-color: Theme.border-color;

                HorizontalLayout {
                    padding: 6px;
                    spacing: 4px;

                    for slot in root.hourly-rows : VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 2px;

                        Text {
                            text: slot.time-label;
                            color: Theme.text-secondary;
                            font-size: 10px;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: slot.icon-glyph;
                            font-size: 13px;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: slot.temp-text;
                            color: Theme.text-primary;
                            font-size: 11.5px;
                            font-weight: 600;
                            horizontal-alignment: center;
                        }
                    }
                }
            }

            // Horizon header + segmented 1д / 3д / 7д selector
            HorizontalLayout {
                height: 24px;
                spacing: 6px;
                alignment: stretch;

                Text {
                    horizontal-stretch: 1;
                    text: root.forecast-days == 1 ? "Прогноз на сегодня"
                        : (root.forecast-days == 7 ? "Прогноз на 7 дней" : "Прогноз на 3 дня");
                    color: Theme.text-secondary;
                    font-size: 11px;
                    font-weight: 600;
                    vertical-alignment: center;
                }

                for d in [1, 3, 7] : Rectangle {
                    width: 32px;
                    height: 22px;
                    border-radius: 6px;
                    background: root.forecast-days == d ? Theme.accent
                        : (d-ta.has-hover ? Theme.hover-bg : Theme.card-bg);
                    border-width: 1px;
                    border-color: root.forecast-days == d ? Theme.accent : Theme.border-color;

                    Text {
                        width: 100%;
                        height: 100%;
                        text: "\{d}д";
                        color: root.forecast-days == d ? #FFFFFF : Theme.text-primary;
                        font-size: 10.5px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    d-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.set-forecast-days(d); }
                    }
                }
            }

            // Daily forecast rows with colored gradient range bars
            VerticalLayout {
                vertical-stretch: 1;
                spacing: 4px;

                for day in root.daily-rows : Rectangle {
                    height: 26px;
                    border-radius: 7px;
                    background: Theme.card-bg;
                    border-width: 1px;
                    border-color: Theme.divider-color;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 6px;
                        alignment: stretch;

                        Text {
                            width: 58px;
                            text: day.day-label;
                            color: Theme.text-primary;
                            font-size: 11.5px;
                            font-weight: 500;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        Text {
                            width: 20px;
                            text: day.icon-glyph;
                            font-size: 13px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        Text {
                            width: 28px;
                            text: day.min-text;
                            color: Theme.text-secondary;
                            font-size: 11px;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;

                            bar-track := Rectangle {
                                height: 6px;
                                border-radius: 3px;
                                background: Theme.input-bg;
                                clip: true;

                                Rectangle {
                                    x: bar-track.width * Math.clamp(day.bar-start, 0.0, 0.85);
                                    y: 0px;
                                    width: Math.max(10px, bar-track.width * Math.clamp(day.bar-span, 0.12, 1.0));
                                    height: 6px;
                                    border-radius: 3px;
                                    background: @linear-gradient(90deg, #38BDF8 0%, #2B90FF 55%, #F59E0B 100%);
                                }
                            }
                        }

                        Text {
                            width: 28px;
                            text: day.max-text;
                            color: Theme.text-primary;
                            font-size: 11px;
                            font-weight: 600;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Error banner
            if (root.error-text != "") : Rectangle {
                height: 24px;
                border-radius: 6px;
                background: rgba(232, 17, 35, 0.16);
                border-width: 1px;
                border-color: rgba(232, 17, 35, 0.40);

                Text {
                    width: 100%;
                    height: 100%;
                    text: root.error-text;
                    color: #FCA5A5;
                    font-size: 10.5px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            // Footer
            HorizontalLayout {
                height: 16px;
                spacing: 4px;
                alignment: stretch;

                Text {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    text: root.footer-text;
                    color: Theme.text-muted;
                    font-size: 10px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        WindowResizeHandles {
            show-se-grip: true;
            resize-window(dir) => { root.resize-window(dir); }
        }
    }
}
