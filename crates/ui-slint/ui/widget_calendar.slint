import { Theme, SlintCalEventRow } from "theme.slint";

component CMenuBtn inherits Rectangle {
    in property <string> label;
    in property <bool> checked: false;
    in property <bool> danger: false;
    callback clicked();

    height: 28px;
    border-radius: 6px;
    background: ta.has-hover
        ? (root.danger ? Theme.danger : Theme.hover-bg)
        : (root.checked ? Theme.accent-tint : transparent);

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        Text {
            horizontal-stretch: 1;
            text: root.label;
            color: (ta.has-hover && root.danger) ? #FFFFFF : Theme.text-primary;
            font-size: 12px;
            font-weight: root.checked ? 600 : 400;
            vertical-alignment: center;
        }
        if (root.checked) : Text {
            text: "●";
            color: Theme.accent;
            font-size: 9px;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component CalendarWindow inherits Window {
    title: "asrbox — Календарь";
    no-frame: true;
    background: transparent;
    preferred-width: 336px;
    preferred-height: 416px;
    min-width: 280px;
    min-height: 220px;

    in property <string> widget-title: "Google Календарь";
    in property <int> period-index: 2; // 0=Today, 1=7d, 2=30d, 3=All
    in property <string> date-format-label: "Вид: дата";
    in property <[SlintCalEventRow]> events: [];
    in property <string> empty-text: "Нет предстоящих событий";
    in property <string> error-text: "";
    in property <bool> loading: false;

    in property <int> layer-index: 0;
    in property <int> opacity-pct: 88;
    in property <int> sync-interval-sec: 3600;

    in property <bool> vis-refresh: true;
    in property <bool> vis-layer: true;
    in property <bool> vis-opacity: true;
    in property <bool> vis-interval: true;
    in property <bool> vis-open-config: true;
    in property <bool> vis-hide: true;

    callback drag-window();
    callback start-resize();
    callback open-settings();
    callback refresh-now();
    callback select-period(int);
    callback cycle-date-format();
    callback open-event-url(string);
    callback dismiss-error();
    callback set-layer(int);
    callback set-opacity(int);
    callback set-sync-interval(int);
    callback open-config();
    callback hide-widget();

    private property <length> ctx-x: 12px;
    private property <length> ctx-y: 36px;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 14px;
        background: Theme.dark-mode
            ? rgba(24, 27, 32, Math.clamp((root.opacity-pct * 1.0) / 100.0, 0.25, 0.98))
            : rgba(243, 245, 248, Math.clamp((root.opacity-pct * 1.0) / 100.0, 0.30, 0.98));
        border-width: 1px;
        border-color: Theme.border-color;
        clip: true;

        Rectangle {
            y: 0px;
            width: 100%;
            height: 1px;
            background: Theme.top-shine;
        }

        TouchArea {
            pointer-event(ev) => {
                if (ev.button == PointerEventButton.right && ev.kind == PointerEventKind.down) {
                    root.ctx-x = Math.clamp(self.mouse-x, 8px, Math.max(8px, root.width - 216px));
                    root.ctx-y = Math.clamp(self.mouse-y, 8px, Math.max(8px, root.height - 250px));
                    ctx-menu.show();
                }
            }
        }

        VerticalLayout {
            padding: 12px;
            spacing: 8px;

            // Header bar (draggable)
            Rectangle {
                height: 28px;
                background: transparent;

                TouchArea {
                    pointer-event(ev) => {
                        if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) {
                            root.drag-window();
                        } else if (ev.button == PointerEventButton.right && ev.kind == PointerEventKind.down) {
                            root.ctx-x = Math.clamp(self.mouse-x, 8px, Math.max(8px, root.width - 216px));
                            root.ctx-y = 34px;
                            ctx-menu.show();
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 4px;
                    alignment: stretch;

                    Text {
                        horizontal-stretch: 1;
                        text: root.widget-title;
                        color: Theme.text-primary;
                        font-size: 14px;
                        font-weight: 700;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 6px;
                        background: add-ta.has-hover ? Theme.hover-bg : transparent;
                        Text {
                            width: 100%;
                            height: 100%;
                            text: "+";
                            color: Theme.accent;
                            font-size: 15px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        add-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.open-settings(); }
                        }
                    }

                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 6px;
                        background: set-ta.has-hover ? Theme.hover-bg : transparent;
                        Text {
                            width: 100%;
                            height: 100%;
                            text: "⚙";
                            color: Theme.text-secondary;
                            font-size: 13px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        set-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.open-settings(); }
                        }
                    }

                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 6px;
                        background: ref-ta.has-hover ? Theme.hover-bg : transparent;
                        Text {
                            width: 100%;
                            height: 100%;
                            text: root.loading ? "…" : "↻";
                            color: Theme.text-secondary;
                            font-size: 13px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        ref-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.refresh-now(); }
                        }
                    }
                }
            }

            // Period filter tabs + date format toggle
            HorizontalLayout {
                height: 24px;
                spacing: 4px;
                alignment: stretch;

                for p[idx] in ["Сегодня", "7д", "30д", "Все"] : Rectangle {
                    border-radius: 6px;
                    background: root.period-index == idx ? Theme.accent
                        : (p-ta.has-hover ? Theme.hover-bg : Theme.card-bg);
                    border-width: 1px;
                    border-color: root.period-index == idx ? Theme.accent : Theme.border-color;

                    HorizontalLayout {
                        padding-left: 7px;
                        padding-right: 7px;
                        Text {
                            text: p;
                            color: root.period-index == idx ? #FFFFFF : Theme.text-primary;
                            font-size: 10.5px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }

                    p-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.select-period(idx); }
                    }
                }

                Rectangle { horizontal-stretch: 1; background: transparent; }

                Rectangle {
                    border-radius: 6px;
                    background: fmt-ta.has-hover ? Theme.hover-bg : Theme.card-bg;
                    border-width: 1px;
                    border-color: Theme.border-color;

                    HorizontalLayout {
                        padding-left: 7px;
                        padding-right: 7px;
                        Text {
                            text: root.date-format-label;
                            color: Theme.text-secondary;
                            font-size: 10px;
                            vertical-alignment: center;
                        }
                    }

                    fmt-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.cycle-date-format(); }
                    }
                }
            }

            // Scrollable events list
            Flickable {
                vertical-stretch: 1;
                viewport-width: self.width;
                viewport-height: ev-col.preferred-height;

                ev-col := VerticalLayout {
                    width: parent.width;
                    spacing: 6px;

                    if (root.events.length == 0) : Rectangle {
                        height: 68px;
                        border-radius: 9px;
                        background: Theme.card-bg;
                        border-width: 1px;
                        border-color: Theme.divider-color;

                        Text {
                            width: 100%;
                            height: 100%;
                            text: root.empty-text;
                            color: Theme.text-secondary;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            wrap: word-wrap;
                        }
                    }

                    for ev in root.events : Rectangle {
                        min-height: 46px;
                        border-radius: 9px;
                        background: ev-ta.has-hover ? Theme.hover-bg : Theme.card-bg;
                        border-width: 1px;
                        border-color: ev.is-today ? Theme.border-strong : Theme.divider-color;
                        animate background { duration: 120ms; }

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 10px;
                            padding-top: 7px;
                            padding-bottom: 7px;
                            spacing: 9px;
                            alignment: stretch;

                            // Left colored accent bar
                            Rectangle {
                                width: 3px;
                                border-radius: 1.5px;
                                background: rgb(ev.accent-r, ev.accent-g, ev.accent-b);
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 2px;

                                Text {
                                    text: ev.summary;
                                    color: Theme.text-primary;
                                    font-size: 12px;
                                    font-weight: 600;
                                    overflow: elide;
                                }

                                Text {
                                    text: ev.subtitle;
                                    color: Theme.text-secondary;
                                    font-size: 10.5px;
                                    overflow: elide;
                                }
                            }
                        }

                        ev-ta := TouchArea {
                            mouse-cursor: pointer;
                            pointer-event(ev-in) => {
                                if (ev-in.button == PointerEventButton.right && ev-in.kind == PointerEventKind.down) {
                                    root.ctx-x = 20px;
                                    root.ctx-y = 48px;
                                    ctx-menu.show();
                                } else if (ev-in.button == PointerEventButton.left && ev-in.kind == PointerEventKind.up) {
                                    root.open-event-url(ev.url);
                                }
                            }
                        }
                    }
                }
            }

            // Dismissible error banner
            if (root.error-text != "") : Rectangle {
                height: 26px;
                border-radius: 6px;
                background: rgba(232, 17, 35, 0.16);
                border-width: 1px;
                border-color: rgba(232, 17, 35, 0.40);

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 6px;
                    spacing: 6px;

                    Text {
                        horizontal-stretch: 1;
                        text: root.error-text;
                        color: #FCA5A5;
                        font-size: 10.5px;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    Rectangle {
                        width: 18px;
                        height: 18px;
                        background: transparent;
                        Text {
                            width: 100%;
                            height: 100%;
                            text: "✕";
                            color: #FCA5A5;
                            font-size: 10px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.dismiss-error(); }
                        }
                    }
                }
            }
        }

        // Bottom-right SE resize grip
        Rectangle {
            x: parent.width - 18px;
            y: parent.height - 18px;
            width: 16px;
            height: 16px;
            background: transparent;

            Text {
                width: 100%;
                height: 100%;
                text: "◢";
                color: res-ta.has-hover ? Theme.accent : Theme.text-muted;
                font-size: 9px;
                horizontal-alignment: right;
                vertical-alignment: bottom;
            }

            res-ta := TouchArea {
                mouse-cursor: nwse-resize;
                pointer-event(ev) => {
                    if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) {
                        root.start-resize();
                    }
                }
            }
        }
    }

    ctx-menu := PopupWindow {
        x: root.ctx-x;
        y: root.ctx-y;
        width: 206px;
        close-policy: PopupClosePolicy.close-on-click-outside;

        Rectangle {
            border-radius: 10px;
            background: Theme.popup-bg;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 18px;
            drop-shadow-color: rgba(0, 0, 0, 0.45);
            drop-shadow-offset-y: 6px;

            VerticalLayout {
                padding: 5px;
                spacing: 2px;

                if (root.vis-refresh) : CMenuBtn {
                    label: "↻  Обновить календарь";
                    clicked => { ctx-menu.close(); root.refresh-now(); }
                }
                CMenuBtn {
                    label: "⚙  Настройки календаря";
                    clicked => { ctx-menu.close(); root.open-settings(); }
                }
                if (root.vis-open-config) : CMenuBtn {
                    label: "📄  Открыть widgets.cfg";
                    clicked => { ctx-menu.close(); root.open-config(); }
                }

                if (root.vis-layer) : Rectangle { height: 1px; background: Theme.divider-color; }
                if (root.vis-layer) : CMenuBtn {
                    label: "Слой: На рабочем столе";
                    checked: root.layer-index == 0;
                    clicked => { ctx-menu.close(); root.set-layer(0); }
                }
                if (root.vis-layer) : CMenuBtn {
                    label: "Слой: Обычный";
                    checked: root.layer-index == 1;
                    clicked => { ctx-menu.close(); root.set-layer(1); }
                }
                if (root.vis-layer) : CMenuBtn {
                    label: "Слой: Поверх окон";
                    checked: root.layer-index == 2;
                    clicked => { ctx-menu.close(); root.set-layer(2); }
                }

                if (root.vis-opacity) : Rectangle { height: 1px; background: Theme.divider-color; }
                if (root.vis-opacity) : HorizontalLayout {
                    height: 26px;
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 4px;
                    for pct in [65, 80, 90, 100] : Rectangle {
                        horizontal-stretch: 1;
                        border-radius: 5px;
                        background: root.opacity-pct == pct ? Theme.accent : Theme.card-bg;
                        Text {
                            width: 100%;
                            height: 100%;
                            text: "\(pct)%";
                            color: root.opacity-pct == pct ? #FFFFFF : Theme.text-primary;
                            font-size: 10.5px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { ctx-menu.close(); root.set-opacity(pct); }
                        }
                    }
                }

                if (root.vis-interval) : HorizontalLayout {
                    height: 26px;
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 4px;
                    for sec in [900, 1800, 3600] : Rectangle {
                        horizontal-stretch: 1;
                        border-radius: 5px;
                        background: root.sync-interval-sec == sec ? Theme.accent : Theme.card-bg;
                        Text {
                            width: 100%;
                            height: 100%;
                            text: sec == 3600 ? "1ч" : "\(Math.round((sec * 1.0) / 60.0))м";
                            color: root.sync-interval-sec == sec ? #FFFFFF : Theme.text-primary;
                            font-size: 10.5px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { ctx-menu.close(); root.set-sync-interval(sec); }
                        }
                    }
                }

                if (root.vis-hide) : Rectangle { height: 1px; background: Theme.divider-color; }
                if (root.vis-hide) : CMenuBtn {
                    label: "✕  Скрыть виджет";
                    danger: true;
                    clicked => { ctx-menu.close(); root.hide-widget(); }
                }
            }
        }
    }
}
