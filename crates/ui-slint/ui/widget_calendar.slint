import { Theme, SlintCalEventRow } from "theme.slint";
import {
    VectorIconClose,
    VectorIconGear,
    VectorIconPlus,
    VectorIconRefresh,
    WindowResizeHandles,
} from "components/window_chrome.slint";

export component CalendarWindow inherits Window {
    title: "asrbox — Календарь";
    no-frame: true;
    background: transparent;
    preferred-width: 336px;
    preferred-height: 416px;
    min-width: 260px;
    min-height: 220px;

    in property <string> widget-title: "Google Календарь";
    in property <int> period-index: 2; // 0=Today, 1=7d, 2=30d, 3=All
    in property <string> date-format-label: "Вид: дата";
    in property <[SlintCalEventRow]> events: [];
    in property <string> empty-text: "Нет предстоящих событий";
    in property <string> error-text: "";
    in property <bool> loading: false;

    callback drag-window();
    callback resize-window(int);
    callback open-settings();
    callback refresh-now();
    callback select-period(int);
    callback cycle-date-format();
    callback open-event-url(string);
    callback dismiss-error();
    callback open-context-menu();

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 8px;
        background: Theme.window-bg;
        border-width: 1px;
        border-color: Theme.border-strong;
        clip: true;

        Rectangle {
            y: 0px;
            width: 100%;
            height: 1px;
            background: Theme.top-shine;
        }

        TouchArea {
            pointer-event(ev) => {
                if (ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up) {
                    root.open-context-menu();
                }
            }
        }

        VerticalLayout {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 100%;
            padding: 12px;
            spacing: 8px;

            // Header bar (draggable)
            Rectangle {
                height: 28px;
                background: transparent;

                TouchArea {
                    pointer-event(ev) => {
                        if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) {
                            root.drag-window();
                        } else if (ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up) {
                            root.open-context-menu();
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 4px;
                    alignment: stretch;

                    Text {
                        horizontal-stretch: 1;
                        min-width: 0px;
                        text: root.widget-title;
                        color: Theme.text-primary;
                        font-size: 14px;
                        font-weight: 700;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 6px;
                        background: add-ta.has-hover ? Theme.hover-bg : transparent;
                        VectorIconPlus {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            size: 12px;
                            icon-color: Theme.accent;
                        }
                        add-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.open-settings(); }
                        }
                    }

                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 6px;
                        background: set-ta.has-hover ? Theme.hover-bg : transparent;
                        VectorIconGear {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            size: 13px;
                            icon-color: set-ta.has-hover ? Theme.text-primary : Theme.text-secondary;
                        }
                        set-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.open-settings(); }
                        }
                    }

                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 6px;
                        background: ref-ta.has-hover ? Theme.hover-bg : transparent;
                        VectorIconRefresh {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            size: 13px;
                            icon-color: root.loading ? Theme.accent
                                : (ref-ta.has-hover ? Theme.text-primary : Theme.text-secondary);
                        }
                        ref-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.refresh-now(); }
                        }
                    }
                }
            }

            // Period filter tabs + date format toggle
            HorizontalLayout {
                height: 24px;
                spacing: 4px;
                alignment: stretch;

                for p[idx] in ["Сегодня", "7д", "30д", "Все"] : Rectangle {
                    border-radius: 6px;
                    background: root.period-index == idx ? Theme.accent
                        : (p-ta.has-hover ? Theme.hover-bg : Theme.card-bg);
                    border-width: 1px;
                    border-color: root.period-index == idx ? Theme.accent : Theme.border-color;

                    HorizontalLayout {
                        padding-left: 7px;
                        padding-right: 7px;
                        Text {
                            text: p;
                            color: root.period-index == idx ? #FFFFFF : Theme.text-primary;
                            font-size: 10.5px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }

                    p-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.select-period(idx); }
                    }
                }

                Rectangle { horizontal-stretch: 1; background: transparent; }

                Rectangle {
                    border-radius: 6px;
                    background: fmt-ta.has-hover ? Theme.hover-bg : Theme.card-bg;
                    border-width: 1px;
                    border-color: Theme.border-color;

                    HorizontalLayout {
                        padding-left: 7px;
                        padding-right: 7px;
                        Text {
                            text: root.date-format-label;
                            color: Theme.text-secondary;
                            font-size: 10px;
                            vertical-alignment: center;
                        }
                    }

                    fmt-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.cycle-date-format(); }
                    }
                }
            }

            // Scrollable events list
            Flickable {
                vertical-stretch: 1;
                content-width: self.width;
                content-height: ev-col.preferred-height;

                ev-col := VerticalLayout {
                    width: parent.width;
                    spacing: 6px;

                    if (root.events.length == 0) : Rectangle {
                        height: 68px;
                        border-radius: 9px;
                        background: Theme.card-bg;
                        border-width: 1px;
                        border-color: Theme.divider-color;

                        Text {
                            width: 100%;
                            height: 100%;
                            text: root.empty-text;
                            color: Theme.text-secondary;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            wrap: word-wrap;
                        }
                    }

                    for ev in root.events : Rectangle {
                        min-height: 46px;
                        border-radius: 9px;
                        background: ev-ta.has-hover ? Theme.hover-bg : Theme.card-bg;
                        border-width: 1px;
                        border-color: ev.is-today ? Theme.border-strong : Theme.divider-color;
                        animate background { duration: 120ms; }

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 10px;
                            padding-top: 7px;
                            padding-bottom: 7px;
                            spacing: 9px;
                            alignment: stretch;

                            // Left colored accent bar
                            Rectangle {
                                width: 3px;
                                border-radius: 1.5px;
                                background: ev.accent-color;
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 2px;

                                Text {
                                    text: ev.summary;
                                    color: Theme.text-primary;
                                    font-size: 12px;
                                    font-weight: 600;
                                    overflow: elide;
                                }

                                Text {
                                    text: ev.subtitle;
                                    color: Theme.text-secondary;
                                    font-size: 10.5px;
                                    overflow: elide;
                                }
                            }
                        }

                        ev-ta := TouchArea {
                            mouse-cursor: pointer;
                            pointer-event(ev-in) => {
                                if (ev-in.button == PointerEventButton.right && ev-in.kind == PointerEventKind.up) {
                                    root.open-context-menu();
                                } else if (ev-in.button == PointerEventButton.left && ev-in.kind == PointerEventKind.up) {
                                    root.open-event-url(ev.url);
                                }
                            }
                        }
                    }
                }
            }

            // Dismissible error banner
            if (root.error-text != "") : Rectangle {
                height: 26px;
                border-radius: 6px;
                background: rgba(232, 17, 35, 0.16);
                border-width: 1px;
                border-color: rgba(232, 17, 35, 0.40);

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 6px;
                    spacing: 6px;

                    Text {
                        horizontal-stretch: 1;
                        text: root.error-text;
                        color: #FCA5A5;
                        font-size: 10.5px;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    Rectangle {
                        width: 18px;
                        height: 18px;
                        background: transparent;
                        VectorIconClose {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            size: 10px;
                            icon-color: #FCA5A5;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.dismiss-error(); }
                        }
                    }
                }
            }
        }

        WindowResizeHandles {
            show-se-grip: true;
            resize-window(dir) => { root.resize-window(dir); }
        }
    }
}
